<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Remote.Protocol" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="ProDiagnostics" Version="12.1.0.6" />
    <PackageVersion Include="ProDataGrid" Version="12.1.0.6" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <!-- AvaloniaEdit -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <!-- Keep Dock, ReactiveUI.Avalonia, ReactiveUI and System.Reactive aligned. -->
    <!-- Dock -->
    <PackageVersion Include="Dock.Avalonia" Version="12.1.0.7" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.7" />
    <PackageVersion Include="Dock.Model.ReactiveUI" Version="12.1.0.7" />
    <PackageVersion Include="Dock.Serializer.SystemTextJson" Version="12.1.0.7" />
    <!-- ReactiveUI -->
    <PackageVersion Include="ReactiveUI" Version="26.0.1" />
    <PackageVersion Include="ReactiveUI.SourceGenerators" Version="4.2.0" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.6" />
    <!-- MSBuild / Roslyn -->
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.9.6" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Features" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <!-- DI -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- TextMate -->
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    <!-- Testing -->
    <!-- Avalonia.Headless.XUnit 12.1.3 uses the xUnit 3 discovery API. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- System.Reactive -->
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <!-- Xaml.Behaviors -->
    <PackageVersion Include="Xaml.Behaviors.Avalonia" Version="12.0.7" />
  </ItemGroup>
</Project>
