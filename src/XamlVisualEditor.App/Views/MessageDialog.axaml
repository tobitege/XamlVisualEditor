<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
        x:Class="XamlVisualEditor.App.Views.MessageDialog"
        Classes="editor-chrome"
        x:DataType="vm:MessageDialogViewModel"
        Title="{CompiledBinding Title}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{CompiledBinding CancelCommand}" />
  </Window.KeyBindings>
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
    <TextBlock Text="{CompiledBinding Title}" FontWeight="SemiBold" />
    <ScrollViewer Grid.Row="1" MaxHeight="420" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <SelectableTextBlock x:Name="MessageText" Text="{CompiledBinding Message}" TextWrapping="Wrap">
        <SelectableTextBlock.ContextFlyout>
          <MenuFlyout>
            <MenuItem Header="{x:Static loc:UiStrings.Copy}" InputGesture="Ctrl+C" Click="OnCopyClick" />
            <MenuItem Header="{x:Static loc:UiStrings.SelectAll}" InputGesture="Ctrl+A" Click="OnSelectAllClick" />
          </MenuFlyout>
        </SelectableTextBlock.ContextFlyout>
      </SelectableTextBlock>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{x:Static loc:UiStrings.Ok}" Command="{CompiledBinding ConfirmCommand}" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
