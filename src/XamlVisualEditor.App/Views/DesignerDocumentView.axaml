<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             xmlns:v="using:XamlVisualEditor.App.Views"
             xmlns:ad="using:XamlVisualEditor.Designer.Adorners"
             x:Class="XamlVisualEditor.App.Views.DesignerDocumentView"
             x:Name="Root"
             x:DataType="vm:DesignerDocumentViewModel">

    <DockPanel>
        <!-- View mode tabs -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="4,2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <WrapPanel.Styles>
                    <Style Selector="WrapPanel > :is(Control)">
                        <Setter Property="Margin" Value="1,1" />
                    </Style>
                </WrapPanel.Styles>
                <RadioButton Content="Split" GroupName="ViewMode"
                             IsChecked="{CompiledBinding ViewMode, Converter={x:Static v:ViewModeConverters.IsSplit}}"
                             Padding="12,4"
                             FontSize="12" />
                <RadioButton Content="Design" GroupName="ViewMode"
                             IsChecked="{CompiledBinding ViewMode, Converter={x:Static v:ViewModeConverters.IsDesign}}"
                             Padding="12,4"
                             FontSize="12" />
                <RadioButton Content="XAML" GroupName="ViewMode"
                             IsChecked="{CompiledBinding ViewMode, Converter={x:Static v:ViewModeConverters.IsCode}}"
                             Padding="12,4"
                             FontSize="12" />
                <ToggleButton Content="Previewer"
                              IsChecked="{CompiledBinding UseExternalPreviewer, Mode=TwoWay}"
                              Padding="12,4"
                              FontSize="12" />
                <Separator Margin="6,0" />
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}"
                              GroupName="SplitDirection" ToolTip.Tip="Top/bottom"
                              AutomationProperties.Name="Split horizontally: top/bottom"
                              IsChecked="{CompiledBinding SplitOrientation, Converter={x:Static v:ViewModeConverters.IsSplitVertical}}"
                              IsVisible="{CompiledBinding ViewMode, Converter={x:Static v:ViewModeConverters.IsSplit}}"
                              Width="28" Height="28" Padding="4"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Width="16" Height="16"
                              Data="M 0,0 H 16 V 16 H 0 Z M 2,2 V 7 H 14 V 2 Z M 2,9 V 14 H 14 V 9 Z" />
                </RadioButton>
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}"
                              GroupName="SplitDirection" ToolTip.Tip="Side by side"
                              AutomationProperties.Name="Split vertically: side by side"
                              IsChecked="{CompiledBinding SplitOrientation, Converter={x:Static v:ViewModeConverters.IsSplitHorizontal}}"
                              IsVisible="{CompiledBinding ViewMode, Converter={x:Static v:ViewModeConverters.IsSplit}}"
                              Width="28" Height="28" Padding="4"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <PathIcon Width="16" Height="16"
                              Data="M 0,0 H 16 V 16 H 0 Z M 2,2 V 14 H 7 V 2 Z M 9,2 V 14 H 14 V 2 Z" />
                </RadioButton>
            </WrapPanel>
        </Border>

        <Grid v:SplitterLayoutBehavior.PersistenceKey="DesignerDocument">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border IsVisible="{CompiledBinding ViewMode, Converter={x:Static v:ViewModeConverters.ShowDesigner}}">
                <Grid.Row>
                    <MultiBinding Converter="{x:Static v:ViewModeConverters.DesignerRowIndex}">
                        <Binding Path="ViewMode" />
                        <Binding Path="SplitOrientation" />
                    </MultiBinding>
                </Grid.Row>
                <Grid.RowSpan>
                    <MultiBinding Converter="{x:Static v:ViewModeConverters.DesignerRowSpan}">
                        <Binding Path="ViewMode" />
                        <Binding Path="SplitOrientation" />
                    </MultiBinding>
                </Grid.RowSpan>
                <Grid.Column>
                    <MultiBinding Converter="{x:Static v:ViewModeConverters.DesignerColumnIndex}">
                        <Binding Path="ViewMode" />
                        <Binding Path="SplitOrientation" />
                    </MultiBinding>
                </Grid.Column>
                <Grid.ColumnSpan>
                    <MultiBinding Converter="{x:Static v:ViewModeConverters.DesignerColumnSpan}">
                        <Binding Path="ViewMode" />
                        <Binding Path="SplitOrientation" />
                    </MultiBinding>
                </Grid.ColumnSpan>
                <Grid>
                    <Border IsVisible="{CompiledBinding UseExternalPreviewer, Converter={x:Static BoolConverters.Not}}">
                        <v:DesignSurfaceView DataContext="{CompiledBinding DesignSurface}" />
                    </Border>
                    <DockPanel IsVisible="{CompiledBinding UseExternalPreviewer}">
                        <v:DesignerViewportToolbar DockPanel.Dock="Top" DataContext="{CompiledBinding DesignSurface}"
                                                   IsExternalPreviewer="True" FitRequested="OnPreviewerFit" SelectionRequested="OnPreviewerSelection" />
                        <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
                            <Border Width="24" Height="24" Background="#252526"
                                    IsVisible="{CompiledBinding DesignSurface.ShowRulers}" />
                            <ad:RulerControl x:Name="ExternalHorizontalRuler" Grid.Column="1" Height="24"
                                             Orientation="Horizontal" Zoom="{CompiledBinding DesignSurface.Zoom}"
                                             Guides="{CompiledBinding DesignSurface.VerticalGuides}"
                                             IsVisible="{CompiledBinding DesignSurface.ShowRulers}" />
                            <ad:RulerControl x:Name="ExternalVerticalRuler" Grid.Row="1" Width="24"
                                             Orientation="Vertical" Zoom="{CompiledBinding DesignSurface.Zoom}"
                                             Guides="{CompiledBinding DesignSurface.HorizontalGuides}"
                                             IsVisible="{CompiledBinding DesignSurface.ShowRulers}" />
                            <ScrollViewer x:Name="PreviewerViewport" Grid.Row="1" Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <v:PreviewerSurfaceControl x:Name="ExternalPreviewSurface" Session="{CompiledBinding PreviewerSession}"
                                                           Document="{CompiledBinding}"
                                                           HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Width="4"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ZIndex="1"
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          Grid.Column="1">
                <GridSplitter.IsVisible>
                    <MultiBinding Converter="{x:Static v:ViewModeConverters.ShowHorizontalSplitter}">
                        <Binding Path="ViewMode" />
                        <Binding Path="SplitOrientation" />
                    </MultiBinding>
                </GridSplitter.IsVisible>
            </GridSplitter>

            <GridSplitter Height="4"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Rows"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ZIndex="1"
                          Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="3">
                <GridSplitter.IsVisible>
                    <MultiBinding Converter="{x:Static v:ViewModeConverters.ShowVerticalSplitter}">
                        <Binding Path="ViewMode" />
                        <Binding Path="SplitOrientation" />
                    </MultiBinding>
                </GridSplitter.IsVisible>
            </GridSplitter>

            <Border MinHeight="120" MinWidth="240"
                    IsVisible="{CompiledBinding ViewMode, Converter={x:Static v:ViewModeConverters.ShowCode}}">
                <Grid.Row>
                    <MultiBinding Converter="{x:Static v:ViewModeConverters.CodeRowIndex}">
                        <Binding Path="ViewMode" />
                        <Binding Path="SplitOrientation" />
                    </MultiBinding>
                </Grid.Row>
                <Grid.RowSpan>
                    <MultiBinding Converter="{x:Static v:ViewModeConverters.CodeRowSpan}">
                        <Binding Path="ViewMode" />
                        <Binding Path="SplitOrientation" />
                    </MultiBinding>
                </Grid.RowSpan>
                <Grid.Column>
                    <MultiBinding Converter="{x:Static v:ViewModeConverters.CodeColumnIndex}">
                        <Binding Path="ViewMode" />
                        <Binding Path="SplitOrientation" />
                    </MultiBinding>
                </Grid.Column>
                <Grid.ColumnSpan>
                    <MultiBinding Converter="{x:Static v:ViewModeConverters.CodeColumnSpan}">
                        <Binding Path="ViewMode" />
                        <Binding Path="SplitOrientation" />
                    </MultiBinding>
                </Grid.ColumnSpan>
                <v:XamlCodeEditorView DataContext="{CompiledBinding CodeEditor}"
                                      v:BreakpointMarginBehavior.IsEnabled="True"
                                      v:BreakpointMarginBehavior.Breakpoints="{CompiledBinding DataContext.Breakpoints, ElementName=Root}"
                                      v:BreakpointMarginBehavior.FilePath="{CompiledBinding DataContext.FilePath, ElementName=Root}"
                                      v:BreakpointMarginBehavior.ExecutionLine="{CompiledBinding DataContext.CodeEditor.ExecutionLine, ElementName=Root}" />
            </Border>
        </Grid>
    </DockPanel>

</UserControl>
