<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
        x:Class="XamlVisualEditor.App.Views.PreviewerTrustDialog"
        Classes="editor-chrome"
        x:DataType="vm:PreviewerTrustDialogViewModel"
        Title="{CompiledBinding Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="{CompiledBinding Title}" FontWeight="SemiBold" />
    <TextBlock Text="{CompiledBinding Message}" TextWrapping="Wrap" />
    <Border Background="#22000000" Padding="8" CornerRadius="4">
      <TextBlock Text="{CompiledBinding Location}" TextWrapping="Wrap" />
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{x:Static loc:UiStrings.Cancel}" Command="{CompiledBinding CancelCommand}" IsCancel="True" />
      <Button Content="{x:Static loc:UiStrings.AllowOnce}" Command="{CompiledBinding AllowOnceCommand}" />
      <Button Content="{x:Static loc:UiStrings.TrustWorkspace}" Command="{CompiledBinding TrustCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
