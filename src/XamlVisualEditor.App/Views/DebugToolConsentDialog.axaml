<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
        x:Class="XamlVisualEditor.App.Views.DebugToolConsentDialog"
        Classes="editor-chrome"
        x:DataType="vm:DebugToolConsentDialogViewModel"
        Title="{CompiledBinding Title}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="{CompiledBinding Title}" FontWeight="SemiBold" />
    <TextBlock Text="{CompiledBinding Message}" TextWrapping="Wrap" />
    <Border Background="#22000000" Padding="8" CornerRadius="4">
      <StackPanel Spacing="4">
        <TextBlock Text="{CompiledBinding ToolId, StringFormat={x:Static loc:UiStrings.ToolFormat}}" />
        <TextBlock Text="{CompiledBinding Version, StringFormat={x:Static loc:UiStrings.VersionFormat}}" />
        <TextBlock Text="{CompiledBinding DownloadUrl, StringFormat={x:Static loc:UiStrings.DownloadFormat}}" TextWrapping="Wrap" />
        <TextBlock Text="{CompiledBinding InstallPath, StringFormat={x:Static loc:UiStrings.InstallToFormat}}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{x:Static loc:UiStrings.Cancel}" Command="{CompiledBinding CancelCommand}" IsCancel="True" />
      <Button Content="{x:Static loc:UiStrings.Download}" Command="{CompiledBinding AllowCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
