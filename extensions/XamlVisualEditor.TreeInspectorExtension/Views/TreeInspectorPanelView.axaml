<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XamlVisualEditor.TreeInspectorExtension"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:dh="using:Avalonia.Controls.DataGridHierarchical"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
             x:Class="XamlVisualEditor.TreeInspectorExtension.Views.TreeInspectorPanelView"
             x:DataType="vm:TreeInspectorPanelViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{CompiledBinding PanelTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button Command="{CompiledBinding CollapseAllCommand}" Width="26" Height="26" MinHeight="26" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  ToolTip.Tip="{x:Static loc:UiStrings.CollapseAll}" AutomationProperties.Name="{x:Static loc:UiStrings.CollapseAll}">
            <PathIcon Width="12" Height="12"
                      Data="M 0,5 L 5,0 L 10,5 L 8.6,6.4 L 5,2.8 L 1.4,6.4 Z M 0,11 L 5,6 L 10,11 L 8.6,12.4 L 5,8.8 L 1.4,12.4 Z" />
          </Button>
          <Button Command="{CompiledBinding ExpandAllCommand}" Width="26" Height="26" MinHeight="26" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  ToolTip.Tip="{x:Static loc:UiStrings.ExpandAll}" AutomationProperties.Name="{x:Static loc:UiStrings.ExpandAll}">
            <PathIcon Width="12" Height="12"
                      Data="M 0,1.4 L 1.4,0 L 5,3.6 L 8.6,0 L 10,1.4 L 5,6.4 Z M 0,7.4 L 1.4,6 L 5,9.6 L 8.6,6 L 10,7.4 L 5,12.4 Z" />
          </Button>
        </StackPanel>
      </Grid>
      <TextBox PlaceholderText="{x:Static loc:UiStrings.SearchNodes}"
               Text="{CompiledBinding SearchText, Mode=TwoWay}" />
      <TextBlock Text="{CompiledBinding StatusText}" TextWrapping="Wrap" />
    </StackPanel>

    <dg:DataGrid ItemsSource="{CompiledBinding TreeModel.Model.Flattened}"
                 HierarchicalModel="{CompiledBinding TreeModel.Model}"
                 HierarchicalRowsEnabled="True"
                 SelectedItem="{CompiledBinding TreeModel.SelectedRow, Mode=TwoWay}"
                 AutoGenerateColumns="False"
                 CanUserResizeColumns="True"
                 CanUserSortColumns="False"
                 GridLinesVisibility="None"
                 IsReadOnly="True"
                 Margin="0,8,0,0">
      <dg:DataGrid.Columns>
        <dg:DataGridHierarchicalColumn Header="{x:Static loc:UiStrings.Node}"
                                       Width="2*" MinWidth="80" Indent="12"
                                       Binding="{CompiledBinding Item}"
                                       x:DataType="dh:HierarchicalNode">
          <dg:DataGridHierarchicalColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TreeInspectorNodeViewModel">
              <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <TextBlock Text="{CompiledBinding NodeGlyph}" FontSize="10" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{CompiledBinding TypeName}" VerticalAlignment="Center"
                           Margin="3,0,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{CompiledBinding TypeName}" />
              </Grid>
            </DataTemplate>
          </dg:DataGridHierarchicalColumn.CellTemplate>
        </dg:DataGridHierarchicalColumn>
        <dg:DataGridTemplateColumn Header="{x:Static loc:UiStrings.Name}" Width="1.5*" MinWidth="80">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}"
                              VerticalAlignment="Center" VerticalContentAlignment="Center">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:TreeInspectorNodeViewModel">
                    <TextBlock Text="{CompiledBinding DisplayName}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding DisplayName}" />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
        <dg:DataGridTemplateColumn Header="{x:Static loc:UiStrings.Children}" Width="Auto" MinWidth="56">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}"
                              VerticalAlignment="Center" VerticalContentAlignment="Center">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:TreeInspectorNodeViewModel">
                    <TextBlock Text="{CompiledBinding ChildCount}" />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
      </dg:DataGrid.Columns>
    </dg:DataGrid>
  </DockPanel>
</UserControl>
