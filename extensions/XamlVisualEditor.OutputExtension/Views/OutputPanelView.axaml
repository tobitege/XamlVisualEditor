<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XamlVisualEditor.OutputExtension"
             xmlns:dg="using:Avalonia.Controls"
             x:Class="XamlVisualEditor.OutputExtension.Views.OutputPanelView"
             x:DataType="vm:OutputPanelViewModel">
  <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,*" Margin="4" ColumnSpacing="4" RowSpacing="4">
    <TextBlock Text="Output (Extension)" FontWeight="SemiBold" Grid.ColumnSpan="2" />

    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Classes="editor-toolbar" Orientation="Horizontal">
      <Button Content="Clear Channel" Command="{CompiledBinding ClearChannelCommand}" Padding="6,2" />
      <Button Content="Clear All" Command="{CompiledBinding ClearAllChannelsCommand}" Padding="6,2" />
      <Button Content="Copy Selected" Command="{CompiledBinding CopySelectedCommand}" Padding="6,2" />
      <Button Content="Copy All" Command="{CompiledBinding CopyAllCommand}" Padding="6,2" />
      <Button Content="Clear Filters" Command="{CompiledBinding ClearFiltersCommand}" Padding="6,2" />
    </WrapPanel>

    <TextBox Grid.Row="2"
             PlaceholderText="Search channels..."
             Text="{CompiledBinding ChannelSearchText, Mode=TwoWay}" />
    <TextBox Grid.Row="2"
             Grid.Column="1"
             PlaceholderText="Search messages..."
             Text="{CompiledBinding MessageSearchText, Mode=TwoWay}" />

    <dg:DataGrid Grid.Row="3"
                 ItemsSource="{CompiledBinding ChannelsView}"
                 SelectedItem="{CompiledBinding SelectedChannel, Mode=TwoWay}"
                 AutoGenerateColumns="False"
                 CanUserSortColumns="True"
                 IsReadOnly="True"
                 GridLinesVisibility="None">
      <dg:DataGrid.Columns>
        <dg:DataGridTextColumn Header="Channel"
                               Width="*"
                               x:DataType="vm:OutputChannelViewModel"
                               Binding="{CompiledBinding Name}" />
      </dg:DataGrid.Columns>
    </dg:DataGrid>

    <dg:DataGrid Grid.Row="3" Grid.Column="1"
                 ItemsSource="{CompiledBinding MessagesView}"
                 SelectedItem="{CompiledBinding SelectedMessage, Mode=TwoWay}"
                 AutoGenerateColumns="False"
                 CanUserSortColumns="True"
                 IsReadOnly="True"
                 GridLinesVisibility="None">
      <dg:DataGrid.Columns>
        <dg:DataGridTemplateColumn Header="Time" Width="80" SortMemberPath="Timestamp">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:OutputMessageEntry">
              <TextBlock Text="{CompiledBinding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                         ToolTip.Tip="{CompiledBinding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss zzz}'}"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
        <dg:DataGridTextColumn Header="Message"
                               Width="*"
                               x:DataType="vm:OutputMessageEntry"
                               Binding="{CompiledBinding Message}" />
      </dg:DataGrid.Columns>
    </dg:DataGrid>
  </Grid>
</UserControl>
