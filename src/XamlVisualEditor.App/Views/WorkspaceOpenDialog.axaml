<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
        xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
        x:Class="XamlVisualEditor.App.Views.WorkspaceOpenDialog"
        x:DataType="vm:WorkspaceOpenDialogViewModel"
        Classes="editor-chrome" Title="{x:Static loc:UiStrings.OpenWorkspace}"
        Width="600" MinWidth="440" SizeToContent="Height" CanResize="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{CompiledBinding CancelCommand}" />
  </Window.KeyBindings>
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="{x:Static loc:UiStrings.SelectProjectOrSolution}" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Name="WorkspacePath" Text="{CompiledBinding FilePath, Mode=TwoWay}" />
      <Button Grid.Column="1" Content="{x:Static loc:UiStrings.Browse}" Command="{CompiledBinding BrowseCommand}" />
    </Grid>
    <CheckBox Name="LoadProjectControls" Content="{x:Static loc:UiStrings.AddProjectControlsToToolbox}"
              IsChecked="{CompiledBinding LoadProjectControls, Mode=TwoWay}" />
    <TextBlock Text="{CompiledBinding Error}" TextWrapping="Wrap" Foreground="Tomato" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="OpenWorkspace" Content="{x:Static loc:UiStrings.Open}" Command="{CompiledBinding OpenCommand}" IsDefault="True" MinWidth="90" />
      <Button Content="{x:Static loc:UiStrings.Cancel}" Command="{CompiledBinding CancelCommand}" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
