<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:dh="using:Avalonia.Controls.DataGridHierarchical"
             xmlns:media="using:Avalonia.Media"
             xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             xmlns:v="using:XamlVisualEditor.App.Views"
             x:DataType="vm:SolutionExplorerViewModel"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
             x:Class="XamlVisualEditor.App.Views.SolutionExplorerView">
  <DockPanel>
    <TextBox DockPanel.Dock="Top"
             PlaceholderText="{x:Static loc:UiStrings.SearchFiles}"
             Text="{CompiledBinding FilterText, Mode=TwoWay}"
             Margin="4" />

    <dg:DataGrid Classes="explorer-compact" ItemsSource="{CompiledBinding Model.Flattened}"
                HierarchicalModel="{CompiledBinding Model}"
                HierarchicalRowsEnabled="True"
                SelectedItem="{CompiledBinding SelectedRow, Mode=TwoWay}"
                SortingModel="{CompiledBinding SortingModel}"
                FilteringModel="{CompiledBinding FilteringModel}"
                SearchModel="{CompiledBinding SearchModel}"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                IsReadOnly="True"
                v:SolutionExplorerDragBehavior.IsEnabled="True"
                v:SolutionExplorerOpenBehavior.IsEnabled="True"
                v:DataGridContextSelectionBehavior.IsEnabled="True">
      <dg:DataGrid.ContextMenu>
        <ContextMenu x:DataType="vm:SolutionExplorerViewModel">
          <MenuItem Header="{x:Static loc:UiStrings.Open}"
                    Command="{CompiledBinding OpenSelectedCommand}" />
          <MenuItem Header="{x:Static loc:UiStrings.SetStartupProject}"
                    Command="{CompiledBinding SetStartupProjectCommand}" />
        </ContextMenu>
      </dg:DataGrid.ContextMenu>
      <dg:DataGrid.DataTemplates>
        <DataTemplate DataType="vm:SolutionExplorerNodeViewModel" x:DataType="vm:SolutionExplorerNodeViewModel">
          <Grid>
            <StackPanel Classes="explorer-row" Orientation="Horizontal">
              <TextBlock Text="▶"
                         Foreground="#2E8B57"
                         IsVisible="{CompiledBinding IsStartupProject}" />
              <TextBlock Text="{x:Static loc:UiStrings.RunUpper}"
                         Foreground="#3C7A3C"
                         FontSize="10"
                         FontWeight="SemiBold"
                         IsVisible="{CompiledBinding IsRunnableButNotStartup}" />
              <ContentControl Content="{CompiledBinding Icon}">
                <ContentControl.DataTemplates>
                  <DataTemplate x:DataType="media:IImage">
                    <Image Width="16" Height="16" Source="{CompiledBinding .}" />
                  </DataTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{CompiledBinding .}" />
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
              <TextBlock Text="{CompiledBinding Name}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </dg:DataGrid.DataTemplates>
      <dg:DataGrid.Columns>
        <dg:DataGridHierarchicalColumn Header="{x:Static loc:UiStrings.Name}"
                                       Width="*"
                                       Binding="{CompiledBinding Item}"
                                       SortMemberPath="Item.Name"
                                       x:DataType="dh:HierarchicalNode">
          <dg:DataGridHierarchicalColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}" />
            </DataTemplate>
          </dg:DataGridHierarchicalColumn.CellTemplate>
        </dg:DataGridHierarchicalColumn>
      </dg:DataGrid.Columns>
    </dg:DataGrid>
  </DockPanel>
</UserControl>
