<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="using:Avalonia.Controls"
        xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
        x:Class="XamlVisualEditor.App.Views.CodeActionPickerDialog"
        Classes="editor-chrome"
        x:DataType="vm:CodeActionPickerDialogViewModel"
        Width="520"
        Height="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top"
               Text="{CompiledBinding Title}"
               FontWeight="SemiBold"
               Margin="0,0,0,8" />

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,8,0,0">
      <Button Content="{x:Static loc:UiStrings.Apply}"
              Command="{CompiledBinding ApplyCommand}"
              MinWidth="80" />
      <Button Content="{x:Static loc:UiStrings.Cancel}"
              Command="{CompiledBinding CancelCommand}"
              MinWidth="80" />
    </StackPanel>

    <dg:DataGrid ItemsSource="{CompiledBinding Items}"
                SelectedItem="{CompiledBinding SelectedItem, Mode=TwoWay}"
                HeadersVisibility="None"
                GridLinesVisibility="None"
                AutoGenerateColumns="False"
                CanUserSortColumns="False"
                IsReadOnly="True">
      <dg:DataGrid.Columns>
        <dg:DataGridTemplateColumn Header="{x:Static loc:UiStrings.Action}" Width="*">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CodeActionItemViewModel">
              <StackPanel Spacing="2">
                <TextBlock Text="{CompiledBinding Title}" />
                <TextBlock Text="{CompiledBinding Kind}"
                           Opacity="0.6"
                           FontSize="11" />
              </StackPanel>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
      </dg:DataGrid.Columns>
      <dg:DataGrid.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{CompiledBinding ApplyCommand}" />
        <KeyBinding Gesture="Return" Command="{CompiledBinding ApplyCommand}" />
      </dg:DataGrid.KeyBindings>
    </dg:DataGrid>
  </DockPanel>
</Window>
