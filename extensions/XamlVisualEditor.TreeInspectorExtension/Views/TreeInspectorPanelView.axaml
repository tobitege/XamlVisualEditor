<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XamlVisualEditor.TreeInspectorExtension"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:dh="using:Avalonia.Controls.DataGridHierarchical"
             x:Class="XamlVisualEditor.TreeInspectorExtension.Views.TreeInspectorPanelView"
             x:DataType="vm:TreeInspectorPanelViewModel">
  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock Text="{CompiledBinding PanelTitle}" FontWeight="SemiBold" />
      <TextBox PlaceholderText="Search nodes..."
               Text="{CompiledBinding SearchText, Mode=TwoWay}" />
      <TextBlock Text="{CompiledBinding StatusText}" TextWrapping="Wrap" />
    </StackPanel>

    <dg:DataGrid ItemsSource="{CompiledBinding TreeModel.Model.Flattened}"
                 HierarchicalModel="{CompiledBinding TreeModel.Model}"
                 HierarchicalRowsEnabled="True"
                 SelectedItem="{CompiledBinding TreeModel.SelectedRow, Mode=TwoWay}"
                 AutoGenerateColumns="False"
                 CanUserResizeColumns="True"
                 CanUserSortColumns="False"
                 GridLinesVisibility="None"
                 IsReadOnly="True"
                 Margin="0,8,0,0">
      <dg:DataGrid.Columns>
        <dg:DataGridHierarchicalColumn Header="Node"
                                       Width="2*" MinWidth="80" Indent="12"
                                       Binding="{CompiledBinding Item}"
                                       x:DataType="dh:HierarchicalNode">
          <dg:DataGridHierarchicalColumn.CellTemplate>
            <DataTemplate x:DataType="vm:TreeInspectorNodeViewModel">
              <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{CompiledBinding NodeGlyph}" FontSize="10" VerticalAlignment="Center" />
                <TextBlock Text="{CompiledBinding TypeName}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </dg:DataGridHierarchicalColumn.CellTemplate>
        </dg:DataGridHierarchicalColumn>
        <dg:DataGridTemplateColumn Header="Name" Width="1.5*" MinWidth="60">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}"
                              VerticalAlignment="Center" VerticalContentAlignment="Center">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:TreeInspectorNodeViewModel">
                    <TextBlock Text="{CompiledBinding DisplayName}" />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
        <dg:DataGridTemplateColumn Header="Children" Width="64" MinWidth="56">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}"
                              VerticalAlignment="Center" VerticalContentAlignment="Center">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:TreeInspectorNodeViewModel">
                    <TextBlock Text="{CompiledBinding ChildCount}" />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
      </dg:DataGrid.Columns>
    </dg:DataGrid>
  </DockPanel>
</UserControl>
