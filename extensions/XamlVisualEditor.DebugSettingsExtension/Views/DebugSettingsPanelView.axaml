<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XamlVisualEditor.DebugSettingsExtension"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
             x:Class="XamlVisualEditor.DebugSettingsExtension.Views.DebugSettingsPanelView"
             x:DataType="vm:DebugSettingsPanelViewModel">
  <DockPanel Margin="8">
    <StackPanel Spacing="8">
      <TextBlock Text="{x:Static loc:UiStrings.DebugSettings}" FontWeight="SemiBold" FontSize="14" />

      <StackPanel Spacing="4">
        <TextBlock Text="{x:Static loc:UiStrings.DebuggerService}" />
        <ComboBox ItemsSource="{CompiledBinding DebuggerServices}"
                  SelectedItem="{CompiledBinding SelectedDebuggerService, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DebuggerServiceOption">
              <TextBlock Text="{CompiledBinding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="{x:Static loc:UiStrings.DebuggerAdapterPath}" />
        <TextBox Text="{CompiledBinding AdapterPath, Mode=TwoWay}" />
      </StackPanel>

      <CheckBox Content="{x:Static loc:UiStrings.AutoDownloadNetcoredbg}"
                IsChecked="{CompiledBinding AutoDownloadTools, Mode=TwoWay}"
                IsEnabled="{CompiledBinding IsNetcoredbgSelected}" />

      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="{x:Static loc:UiStrings.DownloadNetcoredbg}"
                Command="{CompiledBinding DownloadNetcoredbgCommand}" />
        <TextBlock Text="{CompiledBinding StatusText}" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</UserControl>
