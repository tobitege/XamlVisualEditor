<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XamlVisualEditor.OutputExtension"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
             x:Class="XamlVisualEditor.OutputExtension.Views.OutputPanelView"
             x:DataType="vm:OutputPanelViewModel">
  <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,*" Margin="4" ColumnSpacing="4" RowSpacing="4">
    <TextBlock Text="{x:Static loc:UiStrings.ExtensionOutput}" FontWeight="SemiBold" Grid.ColumnSpan="2" />

    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Classes="editor-toolbar" Orientation="Horizontal">
      <Button Content="{x:Static loc:UiStrings.ClearChannel}" Command="{CompiledBinding ClearChannelCommand}" Padding="6,2" />
      <Button Content="{x:Static loc:UiStrings.ClearAll}" Command="{CompiledBinding ClearAllChannelsCommand}" Padding="6,2" />
      <Button Content="{x:Static loc:UiStrings.CopySelectedTitle}" Command="{CompiledBinding CopySelectedCommand}" Padding="6,2" />
      <Button Content="{x:Static loc:UiStrings.CopyAllTitle}" Command="{CompiledBinding CopyAllCommand}" Padding="6,2" />
      <Button Content="{x:Static loc:UiStrings.ClearFiltersTitle}" Command="{CompiledBinding ClearFiltersCommand}" Padding="6,2" />
    </WrapPanel>

    <TextBox Grid.Row="2"
             PlaceholderText="{x:Static loc:UiStrings.SearchChannels}"
             Text="{CompiledBinding ChannelSearchText, Mode=TwoWay}" />
    <TextBox Grid.Row="2"
             Grid.Column="1"
             PlaceholderText="{x:Static loc:UiStrings.SearchMessages}"
             Text="{CompiledBinding MessageSearchText, Mode=TwoWay}" />

    <dg:DataGrid Grid.Row="3"
                 ItemsSource="{CompiledBinding ChannelsView}"
                 SelectedItem="{CompiledBinding SelectedChannel, Mode=TwoWay}"
                 AutoGenerateColumns="False"
                 CanUserResizeColumns="True"
                 CanUserSortColumns="True"
                 IsReadOnly="True"
                 GridLinesVisibility="None">
      <dg:DataGrid.Columns>
        <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Channel}"
                               Width="*"
                               x:DataType="vm:OutputChannelViewModel"
                               Binding="{CompiledBinding Name}" />
      </dg:DataGrid.Columns>
    </dg:DataGrid>

    <dg:DataGrid Grid.Row="3" Grid.Column="1"
                 ItemsSource="{CompiledBinding MessagesView}"
                 SelectedItem="{CompiledBinding SelectedMessage, Mode=TwoWay}"
                 AutoGenerateColumns="False"
                 CanUserResizeColumns="True"
                 CanUserSortColumns="True"
                 IsReadOnly="True"
                 GridLinesVisibility="None">
      <dg:DataGrid.Columns>
        <dg:DataGridTemplateColumn Header="{x:Static loc:UiStrings.Time}" Width="80" SortMemberPath="Timestamp">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:OutputMessageEntry">
              <TextBlock Text="{CompiledBinding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                         ToolTip.Tip="{CompiledBinding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss zzz}'}"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
        <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Message}"
                               Width="*"
                               x:DataType="vm:OutputMessageEntry"
                               Binding="{CompiledBinding Message}" />
      </dg:DataGrid.Columns>
    </dg:DataGrid>
  </Grid>
</UserControl>
