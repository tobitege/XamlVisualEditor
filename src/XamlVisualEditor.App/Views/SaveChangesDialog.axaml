<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
        x:Class="XamlVisualEditor.App.Views.SaveChangesDialog"
        Classes="editor-chrome"
        x:DataType="vm:SaveChangesDialogViewModel"
        Title="{CompiledBinding Title}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{CompiledBinding CancelCommand}" />
  </Window.KeyBindings>
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
    <TextBlock Text="{CompiledBinding Title}" FontWeight="SemiBold" />
    <ScrollViewer Grid.Row="1" MaxHeight="420" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <TextBlock Text="{CompiledBinding Message}" TextWrapping="Wrap" />
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="SaveButton" Content="{CompiledBinding SaveText}" Command="{CompiledBinding SaveCommand}" IsDefault="True" />
      <Button Name="DiscardButton" Content="{CompiledBinding DiscardText}" Command="{CompiledBinding DiscardCommand}" />
      <Button Name="CancelButton" Content="{CompiledBinding CancelText}" Command="{CompiledBinding CancelCommand}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
