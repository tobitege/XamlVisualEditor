<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XamlVisualEditor.OutputExtension"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:dh="using:Avalonia.Controls.DataGridHierarchical"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
             x:Class="XamlVisualEditor.OutputExtension.Views.ProblemsPanelView"
             x:DataType="vm:ProblemsPanelViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="4" RowSpacing="4">
    <WrapPanel Classes="editor-toolbar" Orientation="Horizontal">
      <Button Content="Refresh" Command="{CompiledBinding RefreshCommand}" Padding="6,2" />
      <Button Content="Actions" Padding="6,2">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="Copy selected" Command="{CompiledBinding CopySelectedCommand}" />
            <MenuItem Header="Copy all" Command="{CompiledBinding CopyAllCommand}" />
            <Separator />
            <MenuItem Header="Clear problems" Command="{CompiledBinding ClearCommand}" />
            <MenuItem Header="Clear filters" Command="{CompiledBinding ClearFiltersCommand}" />
            <Separator />
            <MenuItem Header="Show first-seen time" ToggleType="CheckBox"
                      IsChecked="{CompiledBinding ShowFirstSeen, Mode=TwoWay}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <ComboBox Width="140"
                ToolTip.Tip="Diagnostic channel"
                ItemsSource="{CompiledBinding ChannelsView}"
                SelectedItem="{CompiledBinding SelectedChannel, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DiagnosticsChannelViewModel">
            <TextBlock Text="{CompiledBinding DisplayName}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Width="110"
                ToolTip.Tip="Group problems by"
                ItemsSource="{CompiledBinding GroupByOptions}"
                SelectedItem="{CompiledBinding SelectedGroupBy, Mode=TwoWay}" />
      <ComboBox Width="100"
                ToolTip.Tip="Diagnostic severity"
                ItemsSource="{CompiledBinding SeverityOptions}"
                SelectedItem="{CompiledBinding SelectedSeverity, Mode=TwoWay}" />
    </WrapPanel>
    <TextBox Grid.Row="1"
             PlaceholderText="Search diagnostics..."
             Text="{CompiledBinding SearchText, Mode=TwoWay}" />

    <dg:DataGrid x:Name="DiagnosticsGrid" Grid.Row="2"
                 ItemsSource="{CompiledBinding Model.Flattened}"
                 HierarchicalModel="{CompiledBinding Model}"
                 HierarchicalRowsEnabled="True"
                 SelectedItem="{CompiledBinding SelectedRow, Mode=TwoWay}"
                 AutoGenerateColumns="False"
                 CanUserSortColumns="True"
                 IsReadOnly="True"
                 GridLinesVisibility="None">
      <dg:DataGrid.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{CompiledBinding OpenLocationCommand}" />
      </dg:DataGrid.KeyBindings>
      <i:Interaction.Behaviors>
        <ia:EventTriggerBehavior EventName="DoubleTapped">
          <ia:InvokeCommandAction Command="{CompiledBinding OpenLocationCommand}" />
        </ia:EventTriggerBehavior>
      </i:Interaction.Behaviors>
      <dg:DataGrid.DataTemplates>
        <DataTemplate DataType="vm:ProblemsGroupViewModel" x:DataType="vm:ProblemsGroupViewModel">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{CompiledBinding Title}" FontWeight="SemiBold" />
            <TextBlock Text="{CompiledBinding Items.Count, StringFormat='({0})'}" Opacity="0.7" />
          </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:DiagnosticEntryViewModel" x:DataType="vm:DiagnosticEntryViewModel">
          <TextBlock Text="{CompiledBinding Summary}" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{CompiledBinding Tooltip}" />
        </DataTemplate>
      </dg:DataGrid.DataTemplates>
      <dg:DataGrid.Columns>
        <dg:DataGridTemplateColumn Header="Since" Width="80" SortMemberPath="Item.FirstSeen"
                                   IsVisible="{ReflectionBinding DataContext.ShowFirstSeen, ElementName=DiagnosticsGrid}">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}" VerticalContentAlignment="Center">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:ProblemsGroupViewModel"><Panel /></DataTemplate>
                  <DataTemplate DataType="vm:DiagnosticEntryViewModel" x:DataType="vm:DiagnosticEntryViewModel">
                    <TextBlock Text="{CompiledBinding FirstSeenTime}" ToolTip.Tip="{CompiledBinding FirstSeenDetails}" />
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
        <dg:DataGridHierarchicalColumn Header="Message"
                                       Width="*"
                                       MinWidth="120"
                                       Binding="{CompiledBinding Item}"
                                       SortMemberPath="Item.Message"
                                       x:DataType="dh:HierarchicalNode">
          <dg:DataGridHierarchicalColumn.CellTemplate>
            <DataTemplate x:DataType="x:Object">
              <ContentControl Content="{Binding}" VerticalContentAlignment="Center" />
            </DataTemplate>
          </dg:DataGridHierarchicalColumn.CellTemplate>
        </dg:DataGridHierarchicalColumn>
        <dg:DataGridTemplateColumn Header="Severity" Width="68">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}" VerticalContentAlignment="Center">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:ProblemsGroupViewModel"><Panel /></DataTemplate>
                  <DataTemplate DataType="vm:DiagnosticEntryViewModel" x:DataType="vm:DiagnosticEntryViewModel">
                    <TextBlock Text="{CompiledBinding Severity}" />
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
        <dg:DataGridTemplateColumn Header="Location" Width="150">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}" VerticalContentAlignment="Center">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:ProblemsGroupViewModel"><Panel /></DataTemplate>
                  <DataTemplate DataType="vm:DiagnosticEntryViewModel" x:DataType="vm:DiagnosticEntryViewModel">
                    <TextBlock Text="{CompiledBinding Location}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding FilePath}" />
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
        <dg:DataGridTemplateColumn Header="Source" Width="90">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}" VerticalContentAlignment="Center">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:ProblemsGroupViewModel"><Panel /></DataTemplate>
                  <DataTemplate DataType="vm:DiagnosticEntryViewModel" x:DataType="vm:DiagnosticEntryViewModel">
                    <TextBlock Text="{CompiledBinding Source}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding Code}" />
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
      </dg:DataGrid.Columns>
    </dg:DataGrid>
  </Grid>
</UserControl>
