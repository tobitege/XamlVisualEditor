<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:controls="using:XamlVisualEditor.SourceControl.UI.Controls"
             xmlns:views="using:XamlVisualEditor.GitExtension.Views"
             xmlns:vm="using:XamlVisualEditor.GitExtension"
             xmlns:gloc="using:XamlVisualEditor.GitExtension.Localization"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:behaviors="using:XamlVisualEditor.SourceControl.UI.Behaviors"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
             x:Class="XamlVisualEditor.GitExtension.Views.GitPanelView"
             x:DataType="vm:GitPanelViewModel">

    <UserControl.Styles>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector=":is(Button).git-action">
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector=":is(Button).git-action PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector=":is(Button).git-action StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="4" />
        </Style>
        <Style Selector=":is(Button).git-action TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*">
        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="8,6" LastChildFill="False">
            <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Left"
                        IsVisible="{CompiledBinding IsRepository}">
                <TextBlock Text="{x:Static loc:UiStrings.Git}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:UiStrings.BranchLabel}" />
                <TextBlock Text="{CompiledBinding BranchName}" />
                <TextBlock Text="{x:Static loc:UiStrings.UpstreamLabel}" Margin="8,0,0,0" />
                <TextBlock Text="{CompiledBinding UpstreamName}" />
                <TextBlock Text="{x:Static loc:UiStrings.AheadLabel}" Margin="8,0,0,0" />
                <TextBlock Text="{CompiledBinding AheadBy}" />
                <TextBlock Text="{x:Static loc:UiStrings.BehindLabel}" Margin="8,0,0,0" />
                <TextBlock Text="{CompiledBinding BehindBy}" />
            </StackPanel>

            <ToggleButton Classes="git-action"
                          IsChecked="{CompiledBinding IsGitMonitoringEnabled, Mode=OneWay}"
                          Command="{CompiledBinding ToggleMonitoringCommand}"
                          ToolTip.Tip="{x:Static loc:UiStrings.GitMonitoringToggle}"
                          AutomationProperties.Name="{x:Static loc:UiStrings.GitMonitoringToggle}"
                          Margin="8,0,0,0" DockPanel.Dock="Right">
                <StackPanel>
                    <PathIcon Data="{x:Static vm:GitIcons.WatchWorkingFolder}" />
                    <TextBlock Text="{CompiledBinding GitMonitoringLabel}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton Name="GitDiffToggle" Classes="git-action"
                          IsChecked="{CompiledBinding IsDiffVisible, Mode=OneWay}"
                          Command="{CompiledBinding ToggleDiffCommand}"
                          ToolTip.Tip="{CompiledBinding DiffToggleLabel}"
                          AutomationProperties.Name="{CompiledBinding DiffToggleLabel}"
                          Margin="8,0,0,0" DockPanel.Dock="Right">
                <StackPanel>
                    <PathIcon Data="{x:Static vm:GitIcons.ToggleDiff}" />
                    <TextBlock Text="{CompiledBinding DiffToggleLabel}" />
                </StackPanel>
            </ToggleButton>
            <Button Classes="git-action"
                    Command="{CompiledBinding RefreshCommand}"
                    ToolTip.Tip="{x:Static loc:UiStrings.Refresh}"
                    AutomationProperties.Name="{x:Static loc:UiStrings.Refresh}"
                    DockPanel.Dock="Right">
                <StackPanel>
                    <PathIcon Data="{x:Static vm:GitIcons.Refresh}" />
                    <TextBlock Text="{x:Static loc:UiStrings.Refresh}" />
                </StackPanel>
            </Button>
            <ProgressBar Width="80" Height="4" IsIndeterminate="True"
                         IsVisible="{CompiledBinding IsBusy}"
                         VerticalAlignment="Center" Margin="8,0" DockPanel.Dock="Right" />
        </DockPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="8,0,8,6" LastChildFill="True">
            <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Left"
                        IsEnabled="{CompiledBinding IsRepository}">
                <TextBox Width="200"
                         PlaceholderText="{x:Static loc:UiStrings.SearchChanges}"
                         PlaceholderForeground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                         Text="{CompiledBinding SearchText, Mode=TwoWay}" />
                <Button Classes="git-action" Command="{CompiledBinding StageCommand}"
                        ToolTip.Tip="{x:Static loc:UiStrings.Stage}"
                        AutomationProperties.Name="{x:Static loc:UiStrings.Stage}">
                    <StackPanel>
                        <PathIcon Data="{x:Static vm:GitIcons.Stage}" />
                        <TextBlock Text="{x:Static loc:UiStrings.Stage}" />
                    </StackPanel>
                </Button>
                <Button Classes="git-action" Command="{CompiledBinding UnstageCommand}"
                        ToolTip.Tip="{x:Static loc:UiStrings.Unstage}"
                        AutomationProperties.Name="{x:Static loc:UiStrings.Unstage}">
                    <StackPanel>
                        <PathIcon Data="{x:Static vm:GitIcons.Unstage}" />
                        <TextBlock Text="{x:Static loc:UiStrings.Unstage}" />
                    </StackPanel>
                </Button>
                <Button Classes="git-action" Command="{CompiledBinding DiscardCommand}"
                        ToolTip.Tip="{x:Static loc:UiStrings.GitDiscardTooltip}" ToolTip.ShowOnDisabled="True"
                        AutomationProperties.Name="{x:Static loc:UiStrings.Discard}">
                    <StackPanel>
                        <PathIcon Data="{x:Static vm:GitIcons.Discard}" />
                        <TextBlock Text="{x:Static loc:UiStrings.Discard}" />
                    </StackPanel>
                </Button>
                <Button Classes="git-action" Command="{CompiledBinding StageAllCommand}"
                        ToolTip.Tip="{x:Static loc:UiStrings.StageAll}"
                        AutomationProperties.Name="{x:Static loc:UiStrings.StageAll}">
                    <StackPanel>
                        <PathIcon Data="{x:Static vm:GitIcons.StageAll}" />
                        <TextBlock Text="{x:Static loc:UiStrings.StageAll}" />
                    </StackPanel>
                </Button>
                <Button Classes="git-action" Command="{CompiledBinding UnstageAllCommand}"
                        ToolTip.Tip="{x:Static loc:UiStrings.UnstageAll}"
                        AutomationProperties.Name="{x:Static loc:UiStrings.UnstageAll}">
                    <StackPanel>
                        <PathIcon Data="{x:Static vm:GitIcons.UnstageAll}" />
                        <TextBlock Text="{x:Static loc:UiStrings.UnstageAll}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{CompiledBinding ErrorMessage}"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Right" />
        </DockPanel>

        <!-- Operation in progress: what is left to do, continue and abort -->
        <Border Name="GitOperationBanner" Grid.Row="2" Margin="8,0,8,6" Padding="8,4"
                BorderBrush="{DynamicResource SourceControlConflictedBrush}" BorderThickness="1"
                IsVisible="{CompiledBinding IsOperationInProgress}">
            <DockPanel LastChildFill="True">
                <Button Classes="git-action" Command="{CompiledBinding AbortCommand}" DockPanel.Dock="Right" Margin="6,0,0,0"
                        ToolTip.Tip="{x:Static gloc:GitStrings.AbortCommand}"
                        AutomationProperties.Name="{x:Static gloc:GitStrings.AbortCommand}">
                    <StackPanel>
                        <PathIcon Data="{x:Static vm:GitIcons.Abort}" />
                        <TextBlock Text="{x:Static gloc:GitStrings.AbortButton}" />
                    </StackPanel>
                </Button>
                <!-- A merge is completed with Commit. -->
                <Button Classes="git-action" Command="{CompiledBinding ContinueCommand}" DockPanel.Dock="Right"
                        IsVisible="{CompiledBinding !IsMerging}"
                        ToolTip.Tip="{x:Static gloc:GitStrings.ContinueCommand}" ToolTip.ShowOnDisabled="True"
                        AutomationProperties.Name="{x:Static gloc:GitStrings.ContinueCommand}">
                    <StackPanel>
                        <PathIcon Data="{x:Static vm:GitIcons.Continue}" />
                        <TextBlock Text="{x:Static gloc:GitStrings.ContinueButton}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{CompiledBinding OperationSummary}" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Name="GitContentGrid" Grid.Row="3" RowDefinitions="*" Margin="8"
              IsEnabled="{CompiledBinding IsRepository}"
              views:GitDiffPaneBehavior.IsOpen="{CompiledBinding IsDiffVisible}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="3*" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <DockPanel Name="GitListPane" Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
                    <TextBlock Text="{x:Static loc:UiStrings.Commit}" FontWeight="SemiBold" />
                    <!-- Several lines: an amended message keeps its body. -->
                    <TextBox PlaceholderText="{x:Static loc:UiStrings.CommitMessage}"
                             PlaceholderForeground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                             Text="{CompiledBinding CommitMessage, Mode=TwoWay}" />
                    <DockPanel LastChildFill="False">
                        <Button Classes="git-action" Command="{CompiledBinding CommitCommand}"
                                ToolTip.Tip="{x:Static loc:UiStrings.Commit}"
                                AutomationProperties.Name="{x:Static loc:UiStrings.Commit}">
                            <StackPanel>
                                <PathIcon Data="{x:Static vm:GitIcons.Commit}" />
                                <TextBlock Text="{x:Static loc:UiStrings.Commit}" />
                            </StackPanel>
                        </Button>
                        <CheckBox Name="AmendBox" Margin="12,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{CompiledBinding IsAmend, Mode=TwoWay}"
                                  IsEnabled="{CompiledBinding CanAmend}"
                                  Content="{x:Static gloc:GitStrings.AmendLabel}"
                                  ToolTip.Tip="{x:Static gloc:GitStrings.AmendTooltip}" ToolTip.ShowOnDisabled="True"
                                  AutomationProperties.Name="{x:Static gloc:GitStrings.AmendLabel}" />
                    </DockPanel>
                </StackPanel>

                <!-- Conflicted files are listed here and not as changes; staging one marks it resolved. -->
                <DockPanel Name="GitConflictPane" DockPanel.Dock="Top" Margin="0,0,0,8"
                           IsVisible="{CompiledBinding HasConflicts}">
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4"
                               Text="{CompiledBinding ConflictCount, StringFormat={x:Static gloc:GitStrings.ConflictsHeaderFormat}}" />
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Classes="git-action" Command="{CompiledBinding OpenConflictCommand}" Margin="0,0,4,4"
                                ToolTip.Tip="{x:Static gloc:GitStrings.OpenConflictButton}"
                                AutomationProperties.Name="{x:Static gloc:GitStrings.OpenConflictButton}">
                            <StackPanel>
                                <PathIcon Data="{x:Static vm:GitIcons.OpenFile}" />
                                <TextBlock Text="{x:Static gloc:GitStrings.OpenConflictButton}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="git-action" Command="{CompiledBinding AcceptOursCommand}" Margin="0,0,4,4"
                                ToolTip.Tip="{x:Static gloc:GitStrings.AcceptOursCommand}"
                                AutomationProperties.Name="{x:Static gloc:GitStrings.AcceptOursCommand}">
                            <StackPanel>
                                <PathIcon Data="{x:Static vm:GitIcons.AcceptOurs}" />
                                <TextBlock Text="{x:Static gloc:GitStrings.AcceptOursButton}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="git-action" Command="{CompiledBinding AcceptTheirsCommand}" Margin="0,0,4,4"
                                ToolTip.Tip="{x:Static gloc:GitStrings.AcceptTheirsCommand}"
                                AutomationProperties.Name="{x:Static gloc:GitStrings.AcceptTheirsCommand}">
                            <StackPanel>
                                <PathIcon Data="{x:Static vm:GitIcons.AcceptTheirs}" />
                                <TextBlock Text="{x:Static gloc:GitStrings.AcceptTheirsButton}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="git-action" Command="{CompiledBinding MarkResolvedCommand}" Margin="0,0,4,4"
                                ToolTip.Tip="{x:Static gloc:GitStrings.MarkResolvedCommand}"
                                AutomationProperties.Name="{x:Static gloc:GitStrings.MarkResolvedCommand}">
                            <StackPanel>
                                <PathIcon Data="{x:Static vm:GitIcons.MarkResolved}" />
                                <TextBlock Text="{x:Static gloc:GitStrings.MarkResolvedCommand}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <dg:DataGrid Name="GitConflictGrid" MaxHeight="160"
                                 ItemsSource="{CompiledBinding ConflictItems}"
                                 SelectedItem="{CompiledBinding SelectedConflict, Mode=TwoWay}"
                                 AutoGenerateColumns="False"
                                 CanUserResizeColumns="True"
                                 GridLinesVisibility="None"
                                 IsReadOnly="True">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Path}"
                                                   Width="*"
                                                   x:DataType="vm:GitConflictEntryViewModel"
                                                   Binding="{CompiledBinding Path}" />
                            <!-- Fits every kind text, as the status columns of the other lists do. -->
                            <dg:DataGridTemplateColumn Header="{x:Static loc:UiStrings.Status}"
                                                       Width="Auto"
                                                       SortMemberPath="KindLabel"
                                                       x:DataType="vm:GitConflictEntryViewModel"
                                                       ClipboardContentBinding="{CompiledBinding KindLabel}">
                                <dg:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:GitConflictEntryViewModel">
                                        <TextBlock Text="{CompiledBinding KindLabel}" Margin="12,0" VerticalAlignment="Center"
                                                   behaviors:ColumnWidthSamples.Texts="{x:Static vm:GitConflictEntryViewModel.KindLabels}" />
                                    </DataTemplate>
                                </dg:DataGridTemplateColumn.CellTemplate>
                            </dg:DataGridTemplateColumn>
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>
                </DockPanel>

                <TabControl>
                <TabItem Header="{CompiledBinding StagedCount, StringFormat={x:Static loc:UiStrings.StagedCountFormat}}">
                    <dg:DataGrid ItemsSource="{CompiledBinding StagedView}"
                                 SelectedItem="{CompiledBinding SelectedStagedChange, Mode=TwoWay}"
                                 AutoGenerateColumns="False"
                                 CanUserResizeColumns="True"
                                 CanUserSortColumns="True"
                                 GridLinesVisibility="None"
                                 IsReadOnly="True">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Path}"
                                                   Width="*"
                                                   x:DataType="vm:GitChangeEntryViewModel"
                                                   Binding="{CompiledBinding DisplayPath}" />
                            <!-- Fits every status text, so the path column is the only one that shrinks; a copied row
                                 holds the status text. -->
                            <dg:DataGridTemplateColumn Header="{x:Static loc:UiStrings.Status}"
                                                       Width="Auto"
                                                       SortMemberPath="StatusLabel"
                                                       x:DataType="vm:GitChangeEntryViewModel"
                                                       ClipboardContentBinding="{CompiledBinding StatusLabel}">
                                <dg:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:GitChangeEntryViewModel">
                                        <TextBlock Text="{CompiledBinding StatusLabel}" Margin="12,0" VerticalAlignment="Center"
                                                   behaviors:ColumnWidthSamples.Texts="{x:Static vm:GitChangeEntryViewModel.StatusLabels}" />
                                    </DataTemplate>
                                </dg:DataGridTemplateColumn.CellTemplate>
                            </dg:DataGridTemplateColumn>
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>
                </TabItem>
                <TabItem Header="{CompiledBinding UnstagedCount, StringFormat={x:Static loc:UiStrings.UnstagedCountFormat}}">
                    <dg:DataGrid ItemsSource="{CompiledBinding UnstagedView}"
                                 SelectedItem="{CompiledBinding SelectedUnstagedChange, Mode=TwoWay}"
                                 AutoGenerateColumns="False"
                                 CanUserResizeColumns="True"
                                 CanUserSortColumns="True"
                                 GridLinesVisibility="None"
                                 IsReadOnly="True">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Path}"
                                                   Width="*"
                                                   x:DataType="vm:GitChangeEntryViewModel"
                                                   Binding="{CompiledBinding DisplayPath}" />
                            <!-- Fits every status text, so the path column is the only one that shrinks; a copied row
                                 holds the status text. -->
                            <dg:DataGridTemplateColumn Header="{x:Static loc:UiStrings.Status}"
                                                       Width="Auto"
                                                       SortMemberPath="StatusLabel"
                                                       x:DataType="vm:GitChangeEntryViewModel"
                                                       ClipboardContentBinding="{CompiledBinding StatusLabel}">
                                <dg:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:GitChangeEntryViewModel">
                                        <TextBlock Text="{CompiledBinding StatusLabel}" Margin="12,0" VerticalAlignment="Center"
                                                   behaviors:ColumnWidthSamples.Texts="{x:Static vm:GitChangeEntryViewModel.StatusLabels}" />
                                    </DataTemplate>
                                </dg:DataGridTemplateColumn.CellTemplate>
                            </dg:DataGridTemplateColumn>
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>
                </TabItem>
                </TabControl>
            </DockPanel>

            <GridSplitter Name="GitDiffSplitter" Grid.Column="1" Width="4"
                          Background="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          IsVisible="{CompiledBinding IsDiffVisible}"
                          AutomationProperties.Name="{x:Static loc:UiStrings.GitResizeDiff}" />

            <DockPanel Name="GitDiffPane" Grid.Column="2" Margin="8,0,0,0"
                       IsVisible="{CompiledBinding IsDiffVisible}">
                <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{CompiledBinding DiffLineCount, StringFormat={x:Static loc:UiStrings.DiffCountFormat}}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <!-- Without a selection the buttons work on the hunk at the cursor. -->
                    <Button Classes="git-action" Command="{CompiledBinding StageSelectionCommand}"
                            ToolTip.Tip="{x:Static gloc:GitStrings.StageSelectionTooltip}" ToolTip.ShowOnDisabled="True"
                            AutomationProperties.Name="{x:Static gloc:GitStrings.StageSelectionCommand}" Margin="0,0,4,0">
                        <StackPanel>
                            <PathIcon Data="{x:Static vm:GitIcons.StageSelection}" />
                            <TextBlock Text="{x:Static gloc:GitStrings.StageSelectionCommand}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="git-action" Command="{CompiledBinding UnstageSelectionCommand}"
                            ToolTip.Tip="{x:Static gloc:GitStrings.UnstageSelectionTooltip}" ToolTip.ShowOnDisabled="True"
                            AutomationProperties.Name="{x:Static gloc:GitStrings.UnstageSelectionCommand}" Margin="0,0,4,0">
                        <StackPanel>
                            <PathIcon Data="{x:Static vm:GitIcons.UnstageSelection}" />
                            <TextBlock Text="{x:Static gloc:GitStrings.UnstageSelectionCommand}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="git-action" Command="{CompiledBinding DiscardSelectionCommand}"
                            ToolTip.Tip="{x:Static gloc:GitStrings.DiscardSelectionTooltip}" ToolTip.ShowOnDisabled="True"
                            AutomationProperties.Name="{x:Static gloc:GitStrings.DiscardSelectionCommand}">
                        <StackPanel>
                            <PathIcon Data="{x:Static vm:GitIcons.DiscardSelection}" />
                            <TextBlock Text="{x:Static gloc:GitStrings.DiscardSelectionCommand}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <!-- The whole diff is shown, so the hunk at the cursor is never cut off. -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="4">
                    <Panel>
                        <controls:UnifiedDiffEditor Name="GitDiffEditor"
                                                    MaxLineCount="{x:Static sys:Int32.MaxValue}"
                                                    DiffLines="{CompiledBinding DiffLines}"
                                                    CurrentHunkIndex="{CompiledBinding CurrentHunkIndex, Mode=TwoWay}"
                                                    SelectedLineRange="{CompiledBinding SelectedDiffRange, Mode=OneWayToSource}"
                                                    FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                                    FontSize="14"
                                                    HorizontalScrollBarVisibility="Auto"
                                                    VerticalScrollBarVisibility="Auto" />
                        <!-- git shows no usable diff of an unmerged file. -->
                        <TextBlock Name="GitConflictHint" Text="{x:Static gloc:GitStrings.ConflictSelectedHint}"
                                   TextWrapping="Wrap" Margin="8"
                                   IsVisible="{CompiledBinding SelectedConflict, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Panel>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
