<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XamlVisualEditor.Terminal</RootNamespace>
    <Description>Terminal emulator core, PTY integration, and terminal session services</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- The Windows provider uses the in-box ConPTY; do not stage Porta.Pty's OpenConsole.exe in consuming projects. -->
    <PackageReference Include="Porta.Pty" PrivateAssets="contentfiles;analyzers;build;buildtransitive" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XamlVisualEditor.Tests.Unit" />
  </ItemGroup>
</Project>
