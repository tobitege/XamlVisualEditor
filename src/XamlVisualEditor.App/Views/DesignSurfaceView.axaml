<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="using:XamlVisualEditor.Designer.Core"
             xmlns:input="using:Avalonia.Input"
             xmlns:ad="using:XamlVisualEditor.Designer.Adorners"
             xmlns:v="using:XamlVisualEditor.App.Views"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
             x:Class="XamlVisualEditor.App.Views.DesignSurfaceView"
             x:DataType="dc:DesignSurfaceViewModel"
             Background="#1E1E1E"
             Focusable="True"
             input:DragDrop.AllowDrop="True">

    <DockPanel>
        <v:DesignerViewportToolbar DockPanel.Dock="Top" FitRequested="OnZoomToFitClick" SelectionRequested="OnZoomToSelectionClick" />

        <TextBlock x:Name="PreviewStatusText" DockPanel.Dock="Top" IsVisible="False"
                   Margin="8,3" FontSize="11" TextWrapping="Wrap" />

        <!-- Artboard / design canvas with rulers -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    Width="24" Height="24"
                    Background="#252526"
                    IsVisible="{CompiledBinding ShowRulers}" />

            <ad:RulerControl Name="HorizontalRuler"
                             Grid.Row="0" Grid.Column="1"
                             Height="24"
                             Orientation="Horizontal"
                             Zoom="{CompiledBinding Zoom}"
                             Guides="{CompiledBinding VerticalGuides}"
                             IsVisible="{CompiledBinding ShowRulers}" />

            <ad:RulerControl Name="VerticalRuler"
                             Grid.Row="1" Grid.Column="0"
                             Width="24"
                             Orientation="Vertical"
                             Zoom="{CompiledBinding Zoom}"
                             Guides="{CompiledBinding HorizontalGuides}"
                             IsVisible="{CompiledBinding ShowRulers}" />

            <ScrollViewer Name="SurfaceScrollViewer"
                          Grid.Row="1" Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          input:DragDrop.AllowDrop="True">
                    <ThemeVariantScope RequestedThemeVariant="{CompiledBinding PreviewThemeVariant}">
                        <Border Name="SurfaceBorder"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8"
                            BoxShadow="0 2 8 0 #40000000">
                        <!-- The design canvas where controls are rendered -->
                        <Grid Name="ZoomContainer">
                            <Grid.Width>
                                <MultiBinding Converter="{x:Static v:ZoomConverters.Scale}">
                                    <Binding Path="CanvasWidth" />
                                    <Binding Path="Zoom" />
                                </MultiBinding>
                            </Grid.Width>
                            <Grid.Height>
                                <MultiBinding Converter="{x:Static v:ZoomConverters.Scale}">
                                    <Binding Path="CanvasHeight" />
                                    <Binding Path="Zoom" />
                                </MultiBinding>
                            </Grid.Height>
                            <Grid Name="ZoomSurface"
                                Width="{CompiledBinding CanvasWidth}"
                                Height="{CompiledBinding CanvasHeight}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="{CompiledBinding Zoom}"
                                                    ScaleY="{CompiledBinding Zoom}" />
                                </Grid.RenderTransform>
                                <Grid.RenderTransformOrigin>0,0</Grid.RenderTransformOrigin>
                                <Panel Name="DesignCanvas"
                                       Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                       ClipToBounds="True"
                                       input:DragDrop.AllowDrop="True">
                                    <!-- Child controls will be added programmatically -->
                                </Panel>
                                <ad:DesignGridLayer ShowGrid="{CompiledBinding ShowGrid}"
                                                    GridSize="{CompiledBinding GridSnapSize}" />
                                <ad:DesignAdornerLayer Name="AdornerLayer"
                                                       IsVisible="{CompiledBinding IsEditMode}" />
                            </Grid>
                        </Grid>
                    </Border>
                </ThemeVariantScope>
            </ScrollViewer>

            <Border Grid.Row="1"
                    Grid.Column="1"
                    ZIndex="1000"
                    Background="#D01E1E1E"
                    IsHitTestVisible="False"
                    IsVisible="{CompiledBinding IsRebuilding}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressBar Width="280" IsIndeterminate="True" />
                    <TextBlock Text="{CompiledBinding RebuildStatus}"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static loc:UiStrings.UiThreadConstructorsHint}"
                               Foreground="#BFFFFFFF"
                               FontSize="11"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>

</UserControl>
