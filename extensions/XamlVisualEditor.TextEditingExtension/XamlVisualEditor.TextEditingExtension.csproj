<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsXveExtension>true</IsXveExtension>
    <!-- Built into the application; not published as a separate package. -->
    <IsPackable>false</IsPackable>
    <RootNamespace>XamlVisualEditor.TextEditingExtension</RootNamespace>
    <Description>Text editing commands, editor context menu and editor options for the text and code editors</Description>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="ReactiveUI.SourceGenerators" PrivateAssets="all" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XamlVisualEditor.Core\XamlVisualEditor.Core.csproj" />
    <ProjectReference Include="..\..\src\XamlVisualEditor.Extensions\XamlVisualEditor.Extensions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Localization\TextEditingStrings.resx">
      <StronglyTypedLanguage>C#</StronglyTypedLanguage>
      <StronglyTypedNamespace>XamlVisualEditor.TextEditingExtension.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>TextEditingStrings</StronglyTypedClassName>
      <StronglyTypedFileName>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\TextEditingStrings.g.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XamlVisualEditor.Tests.Unit" />
  </ItemGroup>
</Project>
