<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamlVisualEditor.TextEditingExtension.ViewModels"
        xmlns:loc="using:XamlVisualEditor.TextEditingExtension.Localization"
        xmlns:core="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
        x:Class="XamlVisualEditor.TextEditingExtension.Views.TextEditorOptionsDialog"
        x:DataType="vm:TextEditorOptionsViewModel"
        Classes="editor-chrome"
        Title="{x:Static loc:TextEditingStrings.OptionsTitle}"
        Width="820" Height="700" MinWidth="620" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{CompiledBinding CancelCommand}" />
  </Window.KeyBindings>
  <Window.Styles>
    <Style Selector="TextBlock.group">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
      <Button Name="ResetOptions" Content="{x:Static loc:TextEditingStrings.ResetToDefaults}" Command="{CompiledBinding ResetCommand}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Name="SaveOptions" Content="{x:Static core:UiStrings.Save}" Command="{CompiledBinding SaveCommand}" IsDefault="True" MinWidth="90" />
        <Button Name="CancelOptions" Content="{x:Static core:UiStrings.Cancel}" Command="{CompiledBinding CancelCommand}" MinWidth="90" />
      </StackPanel>
    </Grid>
    <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:TextEditingStrings.OptionsHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <ScrollViewer Name="OptionsScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
      <StackPanel Spacing="8" Margin="0,0,16,0">
        <TextBlock Classes="group" Text="{x:Static loc:TextEditingStrings.FontGroup}" />
        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
          <TextBlock Text="{x:Static loc:TextEditingStrings.FontFamily}" VerticalAlignment="Center" />
          <AutoCompleteBox Grid.Column="1" Name="FontFamilyChoice" ItemsSource="{CompiledBinding FontFamilies}"
                           Text="{CompiledBinding FontFamily, Mode=TwoWay}" FilterMode="Contains" MinimumPrefixLength="0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static loc:TextEditingStrings.FontFamilyHint}" TextWrapping="Wrap" Opacity="0.75" />
          <TextBlock Grid.Row="2" Text="{x:Static loc:TextEditingStrings.FontSize}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Name="FontSizeValue" Value="{CompiledBinding FontSize, Mode=TwoWay}"
                         Minimum="8" Maximum="48" Increment="1" FormatString="0.#" HorizontalAlignment="Left" MinWidth="140" />
        </Grid>

        <Separator Margin="0,4" />
        <TextBlock Classes="group" Text="{x:Static loc:TextEditingStrings.DisplayGroup}" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="2">
          <CheckBox Name="WordWrapOption" Content="{x:Static loc:TextEditingStrings.WordWrap}" IsChecked="{CompiledBinding WordWrap, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.LineNumbers}" IsChecked="{CompiledBinding ShowLineNumbers, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.FoldingMargin}" IsChecked="{CompiledBinding ShowFoldingMargin, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.HighlightCurrentLine}" IsChecked="{CompiledBinding HighlightCurrentLine, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.ShowSpaces}" IsChecked="{CompiledBinding ShowSpaces, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.ShowTabs}" IsChecked="{CompiledBinding ShowTabs, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.ShowEndOfLineOption}" IsChecked="{CompiledBinding ShowEndOfLine, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.ShowControlCharacters}" IsChecked="{CompiledBinding ShowBoxForControlCharacters, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.InheritWrapIndentation}" IsChecked="{CompiledBinding InheritWordWrapIndentation, Mode=TwoWay}" />
        </WrapPanel>
        <Grid ColumnDefinitions="200,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
          <CheckBox Content="{x:Static loc:TextEditingStrings.ColumnRuler}" IsChecked="{CompiledBinding ShowColumnRuler, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Text="{x:Static loc:TextEditingStrings.ColumnRulerPosition}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{CompiledBinding ColumnRulerPosition, Mode=TwoWay}"
                         IsEnabled="{CompiledBinding ShowColumnRuler}" Minimum="20" Maximum="400" Increment="1" FormatString="0" MinWidth="140" />
          <TextBlock Grid.Row="2" Text="{x:Static loc:TextEditingStrings.WrapIndentation}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{CompiledBinding WordWrapIndentation, Mode=TwoWay}"
                         IsEnabled="{CompiledBinding WordWrap}" Minimum="0" Maximum="32" Increment="1" FormatString="0" MinWidth="140" />
        </Grid>

        <Separator Margin="0,4" />
        <TextBlock Classes="group" Text="{x:Static loc:TextEditingStrings.EditingGroup}" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="2">
          <CheckBox Content="{x:Static loc:TextEditingStrings.AcceptsTab}" IsChecked="{CompiledBinding AcceptsTab, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.ConvertTabsToSpaces}" IsChecked="{CompiledBinding ConvertTabsToSpaces, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.RectangularSelection}" IsChecked="{CompiledBinding EnableRectangularSelection, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.VirtualSpace}" IsChecked="{CompiledBinding EnableVirtualSpace, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.TextDragDrop}" IsChecked="{CompiledBinding EnableTextDragDrop, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.CutCopyWholeLine}" IsChecked="{CompiledBinding CutCopyWholeLine, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.HideCursorWhileTyping}" IsChecked="{CompiledBinding HideCursorWhileTyping, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.ScrollBelowDocument}" IsChecked="{CompiledBinding AllowScrollBelowDocument, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.RightClickMovesCaret}" IsChecked="{CompiledBinding RightClickMovesCaret, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.AllowOverstrike}" IsChecked="{CompiledBinding AllowToggleOverstrikeMode, Mode=TwoWay}" />
        </WrapPanel>
        <Grid ColumnDefinitions="200,Auto" ColumnSpacing="8">
          <TextBlock Text="{x:Static loc:TextEditingStrings.IndentationSize}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Value="{CompiledBinding IndentationSize, Mode=TwoWay}"
                         Minimum="1" Maximum="16" Increment="1" FormatString="0" MinWidth="140" />
        </Grid>

        <Separator Margin="0,4" />
        <TextBlock Classes="group" Text="{x:Static loc:TextEditingStrings.LinksGroup}" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="2">
          <CheckBox Content="{x:Static loc:TextEditingStrings.EnableHyperlinks}" IsChecked="{CompiledBinding EnableHyperlinks, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.EnableEmailHyperlinks}" IsChecked="{CompiledBinding EnableEmailHyperlinks, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.RequireCtrlForLinks}" IsChecked="{CompiledBinding RequireControlModifierForHyperlinkClick, Mode=TwoWay}" />
          <CheckBox Content="{x:Static loc:TextEditingStrings.ExtendSelectionOnMouseUp}" IsChecked="{CompiledBinding ExtendSelectionOnMouseUp, Mode=TwoWay}" />
        </WrapPanel>

        <Separator Margin="0,4" />
        <TextBlock Classes="group" Text="{x:Static loc:TextEditingStrings.ColorsGroup}" />
        <Grid ColumnDefinitions="200,240" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
          <TextBlock Text="{x:Static loc:TextEditingStrings.BackgroundColor}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" Name="BackgroundColorChoice" ItemsSource="{CompiledBinding BackgroundColors}"
                    SelectedItem="{CompiledBinding BackgroundColor, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="1" Text="{x:Static loc:TextEditingStrings.LineNumbersColor}" VerticalAlignment="Center" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{CompiledBinding LineNumbersColors}"
                    SelectedItem="{CompiledBinding LineNumbersColor, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="2" Text="{x:Static loc:TextEditingStrings.ColumnRulerColor}" VerticalAlignment="Center" />
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{CompiledBinding ColumnRulerColors}"
                    SelectedItem="{CompiledBinding ColumnRulerColor, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
