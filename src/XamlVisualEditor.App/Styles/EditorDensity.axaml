<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The class belongs only to editor chrome, never to a rendered document. -->
    <Style Selector=".editor-chrome .editor-toolbar > :is(Control)">
        <Setter Property="Margin" Value="0,0,4,2" />
    </Style>

    <!-- Desktop density: buttons and inputs share a minimum height of 23; the caption stays centered in it. -->
    <Style Selector=".editor-chrome :is(Button)">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector=".editor-chrome TextBox, .editor-chrome ComboBox, .editor-chrome NumericUpDown, .editor-chrome AutoCompleteBox">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinHeight" Value="23" />
    </Style>

    <Style Selector=".editor-chrome CheckBox, .editor-chrome RadioButton">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinHeight" Value="22" />
    </Style>

    <Style Selector=".editor-chrome ListBoxItem, .editor-chrome TreeViewItem">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <Style Selector=".editor-chrome MenuItem, .editor-chrome TabItem">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <!-- A menu item with the header "-" is a separator and keeps the height of a plain Separator. -->
    <Style Selector=".editor-chrome MenuItem:separator">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector=".editor-chrome TabItem">
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    </Style>

    <Style Selector=".editor-chrome DataGridCell, .editor-chrome DataGridColumnHeader">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector=".editor-chrome DataGridRow">
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <!-- Compact rows for the File Explorer and the Solution Explorer only. -->
    <Style Selector="DataGrid.explorer-compact">
        <Setter Property="RowHeight" Value="24" />
        <Setter Property="ColumnHeaderHeight" Value="24" />
    </Style>
    <Style Selector="DataGrid.explorer-compact DataGridRow, DataGrid.explorer-compact DataGridCell">
        <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="DataGrid.explorer-compact DataGridCell">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="DataGrid.explorer-compact DataGridCell ToggleButton">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="StackPanel.explorer-row">
        <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="DataGrid.explorer-compact StackPanel.explorer-row">
        <Setter Property="Spacing" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
