<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
        xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
        x:Class="XamlVisualEditor.App.Views.ConfirmDialog"
        Classes="editor-chrome"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{CompiledBinding Title}"
        Width="420"
        Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="{CompiledBinding Title}" FontWeight="SemiBold" />
    <TextBlock Text="{CompiledBinding Message}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="ConfirmButton" Content="{CompiledBinding ConfirmText}" Command="{CompiledBinding ConfirmCommand}" IsDefault="True" />
      <Button Name="CancelButton" Content="{x:Static loc:UiStrings.Cancel}" Command="{CompiledBinding CancelCommand}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
