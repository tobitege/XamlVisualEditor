<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamlVisualEditor.AcpExtension"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
        x:Class="XamlVisualEditor.AcpExtension.Views.AcpPermissionDialog"
        x:DataType="vm:AcpPermissionDialogViewModel"
        Width="560" Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="{CompiledBinding Title}" FontWeight="SemiBold" />
    <TextBlock Text="{CompiledBinding Message}" TextWrapping="Wrap" />
    <Border Background="#22000000" Padding="8" CornerRadius="4">
      <StackPanel Spacing="4">
        <TextBlock Text="{CompiledBinding SessionId, StringFormat={x:Static loc:UiStrings.SessionFormat}}" />
        <TextBlock Text="{CompiledBinding ToolKind, StringFormat={x:Static loc:UiStrings.KindFormat}}" />
        <TextBlock Text="{CompiledBinding ToolTitle, StringFormat={x:Static loc:UiStrings.TitleFormat}}" TextWrapping="Wrap" />
        <TextBlock Text="{CompiledBinding ToolCallId, StringFormat={x:Static loc:UiStrings.ToolCallFormat}}" />
      </StackPanel>
    </Border>
    <StackPanel Spacing="6">
      <ItemsControl ItemsSource="{CompiledBinding Options}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AcpPermissionOptionViewModel">
            <Button Content="{CompiledBinding Name}" Command="{CompiledBinding SelectCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{x:Static loc:UiStrings.Cancel}" Command="{CompiledBinding CancelCommand}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
