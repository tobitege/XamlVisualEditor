<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             xmlns:v="using:XamlVisualEditor.App.Views"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
             x:Class="XamlVisualEditor.App.Views.AnimationEditorView"
             x:DataType="vm:AnimationEditorViewModel"
             Classes="editor-chrome">

    <UserControl.Styles>
        <Style Selector="Button.icon, ToggleButton.icon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Border.tool-separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Border.track-header">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="4,0,6,0" />
        </Style>
        <Style Selector="Border.track-header.selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar: transport, history, structure, keyframe clipboard -->
        <Border Grid.Row="0"
                Name="AnimationToolbar"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,3">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <WrapPanel Grid.Column="0" Name="AnimationToolbarItems" Orientation="Horizontal" ItemSpacing="2" LineSpacing="2" VerticalAlignment="Center">
                    <Button Classes="icon" Command="{CompiledBinding PlayPreviewCommand}"
                            ToolTip.Tip="{x:Static loc:UiStrings.Play}"
                            AutomationProperties.Name="{x:Static loc:UiStrings.Play}">
                        <PathIcon Data="{x:Static vm:AnimationEditorIcons.Play}" />
                    </Button>
                    <Button Classes="icon" Command="{CompiledBinding StopPreviewCommand}"
                            ToolTip.Tip="{x:Static loc:UiStrings.Stop}"
                            AutomationProperties.Name="{x:Static loc:UiStrings.Stop}">
                        <PathIcon Data="{x:Static vm:AnimationEditorIcons.Stop}" />
                    </Button>
                    <Border Classes="tool-separator" />
                    <Button Classes="icon" Command="{CompiledBinding UndoCommand}"
                            ToolTip.Tip="{x:Static loc:UiStrings.Undo}"
                            AutomationProperties.Name="{x:Static loc:UiStrings.Undo}">
                        <PathIcon Data="{x:Static vm:AnimationEditorIcons.Undo}" />
                    </Button>
                    <Button Classes="icon" Command="{CompiledBinding RedoCommand}"
                            ToolTip.Tip="{x:Static loc:UiStrings.Redo}"
                            AutomationProperties.Name="{x:Static loc:UiStrings.Redo}">
                        <PathIcon Data="{x:Static vm:AnimationEditorIcons.Redo}" />
                    </Button>
                    <Border Classes="tool-separator" />
                    <ComboBox Name="TimelineSelector"
                              ItemsSource="{CompiledBinding Timelines}"
                              SelectedItem="{CompiledBinding SelectedTimeline, Mode=TwoWay}"
                              PlaceholderText="{x:Static loc:UiStrings.Timeline}"
                              MinWidth="150"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnimationTimelineViewModel">
                                <TextBlock Text="{CompiledBinding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="icon" Command="{CompiledBinding AddTimelineCommand}"
                            ToolTip.Tip="{x:Static loc:UiStrings.AddTimeline}"
                            AutomationProperties.Name="{x:Static loc:UiStrings.AddTimeline}">
                        <PathIcon Data="{x:Static vm:AnimationEditorIcons.Add}" />
                    </Button>
                    <Border Classes="tool-separator" />
                    <TextBox Name="NewTrackName"
                             Width="130"
                             VerticalAlignment="Center"
                             Text="{CompiledBinding NewTrackPropertyName, Mode=TwoWay}"
                             PlaceholderText="{x:Static loc:UiStrings.Opacity}"
                             ToolTip.Tip="{x:Static loc:UiStrings.Track}" />
                    <Button Classes="icon" Command="{CompiledBinding AddTrackCommand}"
                            ToolTip.Tip="{x:Static loc:UiStrings.AddTrack}"
                            AutomationProperties.Name="{x:Static loc:UiStrings.AddTrack}">
                        <PathIcon Data="{x:Static vm:AnimationEditorIcons.Add}" />
                    </Button>
                    <Border Classes="tool-separator" />
                    <Button Classes="icon" Command="{CompiledBinding AddKeyframeCommand}"
                            ToolTip.Tip="{x:Static loc:UiStrings.AddKeyframe}"
                            AutomationProperties.Name="{x:Static loc:UiStrings.AddKeyframe}">
                        <PathIcon Data="{x:Static vm:AnimationEditorIcons.Keyframe}" />
                    </Button>
                    <Button Classes="icon" Command="{CompiledBinding CopyKeyframesCommand}"
                            ToolTip.Tip="{x:Static loc:UiStrings.Copy}"
                            AutomationProperties.Name="{x:Static loc:UiStrings.Copy}">
                        <PathIcon Data="{x:Static vm:AnimationEditorIcons.Copy}" />
                    </Button>
                    <Button Classes="icon" Command="{CompiledBinding PasteKeyframesCommand}"
                            ToolTip.Tip="{x:Static loc:UiStrings.Paste}"
                            AutomationProperties.Name="{x:Static loc:UiStrings.Paste}">
                        <PathIcon Data="{x:Static vm:AnimationEditorIcons.Paste}" />
                    </Button>
                    <Button Classes="icon" Command="{CompiledBinding DeleteSelectionCommand}"
                            ToolTip.Tip="{x:Static loc:UiStrings.Delete}"
                            AutomationProperties.Name="{x:Static loc:UiStrings.Delete}">
                        <PathIcon Data="{x:Static vm:AnimationEditorIcons.Delete}" />
                    </Button>
                </WrapPanel>

                <TextBlock Grid.Column="1"
                           Name="AnimationStatus"
                           Text="{CompiledBinding StatusMessage}"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="200" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <!-- Timeline: ruler and tracks -->
            <ScrollViewer Grid.Column="0"
                          Name="TimelineScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MinWidth="{CompiledBinding #TimelineScroll.Viewport.Width}">
                    <Grid ColumnDefinitions="200,*" Height="24">
                        <Border Grid.Column="0"
                                Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="0,0,1,1"
                                Padding="8,0">
                            <TextBlock Text="{x:Static loc:UiStrings.Track}"
                                       Classes="section"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1"
                                Background="#191919"
                                BorderBrush="#2A2A2A"
                                BorderThickness="0,0,0,1">
                            <Canvas Height="24"
                                    Width="{ReflectionBinding DataContext.TimelineWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{CompiledBinding RulerTicks}"
                                              Height="24"
                                              Width="{ReflectionBinding DataContext.TimelineWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TimelineTickViewModel">
                                            <Canvas>
                                                <Border Width="1"
                                                        Height="{CompiledBinding Height}"
                                                        Background="#4B4B4B"
                                                        Opacity="{CompiledBinding Opacity}"
                                                        Canvas.Top="0">
                                                    <Canvas.Left>
                                                        <Binding Path="PositionPixels" />
                                                    </Canvas.Left>
                                                </Border>
                                                <TextBlock Text="{CompiledBinding Label}"
                                                           FontSize="10"
                                                           Foreground="#B5B5B5"
                                                           Canvas.Top="11">
                                                    <Canvas.Left>
                                                        <Binding Path="PositionPixels" />
                                                    </Canvas.Left>
                                                </TextBlock>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Width="2" Height="24" Background="#E24A4A">
                                    <Canvas.Left>
                                        <MultiBinding Converter="{x:Static v:TimelineConverters.TimeToPixels}">
                                            <ReflectionBinding Path="DataContext.CurrentTimeSeconds" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <ReflectionBinding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </Canvas.Left>
                                </Border>
                                <Border Background="#E24A4A" CornerRadius="3" Padding="4,1">
                                    <Canvas.Left>
                                        <MultiBinding Converter="{x:Static v:TimelineConverters.TimeToPixels}">
                                            <ReflectionBinding Path="DataContext.CurrentTimeSeconds" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <ReflectionBinding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </Canvas.Left>
                                    <Canvas.Top>-1</Canvas.Top>
                                    <TextBlock Text="{CompiledBinding CurrentTimeSeconds, StringFormat='{}{0:0.00}s'}"
                                               FontSize="10"
                                               Foreground="White" />
                                </Border>
                            </Canvas>
                        </Border>
                    </Grid>

                    <ItemsControl Name="TrackList" ItemsSource="{CompiledBinding SelectedTimeline.Tracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnimationTrackViewModel">
                                <Grid ColumnDefinitions="200,*" Height="32">
                                    <Border Grid.Column="0"
                                            Classes="track-header"
                                            Classes.selected="{CompiledBinding IsSelected}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                            <Button Classes="icon"
                                                    Command="{ReflectionBinding DataContext.SelectTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{x:Static loc:UiStrings.Select}"
                                                    AutomationProperties.Name="{x:Static loc:UiStrings.Select}">
                                                <PathIcon Data="{x:Static vm:AnimationEditorIcons.SelectTrack}" />
                                            </Button>
                                            <TextBox Grid.Column="1"
                                                     Text="{CompiledBinding PropertyName, Mode=TwoWay}"
                                                     VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="#1F1F1F"
                                            BorderBrush="#2A2A2A"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Canvas Height="32"
                                                    Width="{ReflectionBinding DataContext.TimelineWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    HorizontalAlignment="Left">
                                                <ItemsControl ItemsSource="{ReflectionBinding DataContext.RulerTicks, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              Height="32"
                                                              Width="{ReflectionBinding DataContext.TimelineWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:TimelineTickViewModel">
                                                            <!-- Canvas root: the item container ignores Canvas.Left, the inner Canvas honours it. -->
                                                            <Canvas>
                                                                <Border Width="1"
                                                                        Height="32"
                                                                        Background="#2F2F2F"
                                                                        Opacity="{CompiledBinding Opacity}">
                                                                    <Canvas.Left>
                                                                        <Binding Path="PositionPixels" />
                                                                    </Canvas.Left>
                                                                </Border>
                                                            </Canvas>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Canvas>

                                            <Canvas Height="32"
                                                    Width="{ReflectionBinding DataContext.TimelineWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    HorizontalAlignment="Left"
                                                    v:TimelineScrubBehavior.ScrubCommand="{ReflectionBinding DataContext.SetCurrentTimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    v:TimelineScrubBehavior.PixelsPerSecond="{ReflectionBinding DataContext.PixelsPerSecond, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <ItemsControl ItemsSource="{CompiledBinding Keyframes}"
                                                              Height="32"
                                                              Width="{ReflectionBinding DataContext.TimelineWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:AnimationKeyframeViewModel">
                                                            <!-- Canvas root: the item container ignores Canvas.Left, the inner Canvas honours it. -->
                                                            <Canvas>
                                                                <Border Width="10" Height="10"
                                                                        CornerRadius="2"
                                                                        Background="{CompiledBinding IsSelected, Converter={x:Static v:TimelineConverters.SelectionToBrush}}"
                                                                        BorderBrush="#2A2A2A"
                                                                        BorderThickness="1"
                                                                        Canvas.Top="11"
                                                                        v:TimelineKeyframeDragBehavior.IsEnabled="True"
                                                                        v:TimelineKeyframeDragBehavior.PixelsPerSecond="{ReflectionBinding DataContext.PixelsPerSecond, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        v:TimelineKeyframeDragBehavior.DurationSeconds="{ReflectionBinding DataContext.SelectedTimeline.DurationSeconds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        v:TimelineKeyframeDragBehavior.SnapIntervalSeconds="{ReflectionBinding DataContext.SnapIntervalSeconds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        v:TimelineKeyframeDragBehavior.SelectCommand="{ReflectionBinding DataContext.SelectKeyframeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        v:TimelineKeyframeDragBehavior.CommitMoveCommand="{ReflectionBinding DataContext.CommitMoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                    <Canvas.Left>
                                                                        <MultiBinding Converter="{x:Static v:TimelineConverters.TimeToPixels}">
                                                                            <Binding Path="TimeSeconds" />
                                                                            <ReflectionBinding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                        </MultiBinding>
                                                                    </Canvas.Left>
                                                                    <ToolTip.Tip>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{CompiledBinding TimeSeconds, StringFormat={x:Static loc:UiStrings.TimeSecondsFormat}}" />
                                                                            <TextBlock Text="{CompiledBinding Value}" />
                                                                        </StackPanel>
                                                                    </ToolTip.Tip>
                                                                    <Border.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="{x:Static loc:UiStrings.Copy}"
                                                                                      Command="{ReflectionBinding DataContext.CopyKeyframesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                                            <MenuItem Header="{x:Static loc:UiStrings.Paste}"
                                                                                      Command="{ReflectionBinding DataContext.PasteKeyframesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                                            <MenuItem Header="{x:Static loc:UiStrings.Delete}"
                                                                                      Command="{ReflectionBinding DataContext.DeleteSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                                        </ContextMenu>
                                                                    </Border.ContextMenu>
                                                                </Border>
                                                            </Canvas>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Width="2" Height="32" Background="#E24A4A">
                                                    <Canvas.Left>
                                                        <MultiBinding Converter="{x:Static v:TimelineConverters.TimeToPixels}">
                                                            <ReflectionBinding Path="DataContext.CurrentTimeSeconds" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            <ReflectionBinding Path="DataContext.PixelsPerSecond" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </Canvas.Left>
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Inspector: timeline, resources, target and keyframe details -->
            <Border Grid.Column="1"
                    Name="AnimationInspector"
                    Width="280"
                    Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,6,10,10" Spacing="6">

                        <TextBlock Classes="section" Text="{x:Static loc:UiStrings.Timeline}" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                            <TextBlock Grid.Row="0" Classes="field-label" Text="{x:Static loc:UiStrings.Key}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Name="TimelineKey"
                                     Text="{CompiledBinding SelectedTimeline.ResourceKey, Mode=TwoWay}"
                                     PlaceholderText="{x:Static loc:UiStrings.AnimationKeyExample}" />
                            <TextBlock Grid.Row="1" Classes="field-label" Text="{x:Static loc:UiStrings.Duration}" />
                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <TextBox Name="TimelineDuration"
                                         Text="{CompiledBinding SelectedTimeline.DurationSeconds, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Classes="field-label" Text="s" />
                            </Grid>
                            <TextBlock Grid.Row="2" Classes="field-label" Text="{x:Static loc:UiStrings.Zoom}" />
                            <Slider Grid.Row="2" Grid.Column="1"
                                    Name="TimelineZoom"
                                    Minimum="0.25" Maximum="3.0"
                                    Value="{CompiledBinding Zoom, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Classes="field-label" Text="{x:Static loc:UiStrings.Scope}" />
                            <ComboBox Grid.Row="3" Grid.Column="1"
                                      Name="ResourceScope"
                                      ItemsSource="{CompiledBinding ResourceScopes}"
                                      SelectedItem="{CompiledBinding SelectedScope, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AnimationResourceScopeEntry">
                                        <TextBlock Text="{CompiledBinding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Button Name="CreateResourceButton"
                                Command="{CompiledBinding CreateResourceCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="14" Height="14" Data="{x:Static vm:AnimationEditorIcons.CreateResource}" />
                                <TextBlock Text="{x:Static loc:UiStrings.CreateResource}" />
                            </StackPanel>
                        </Button>

                        <TextBlock Classes="section" Text="{x:Static loc:UiStrings.Resources}" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="2">
                            <ComboBox Grid.Column="0"
                                      Name="ResourceSelector"
                                      ItemsSource="{CompiledBinding AvailableResources}"
                                      SelectedItem="{CompiledBinding SelectedResource, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,4,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AnimationResourceEntryViewModel">
                                        <TextBlock Text="{CompiledBinding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Classes="icon" Command="{CompiledBinding RefreshResourcesCommand}"
                                    ToolTip.Tip="{x:Static loc:UiStrings.Refresh}"
                                    AutomationProperties.Name="{x:Static loc:UiStrings.Refresh}">
                                <PathIcon Data="{x:Static vm:AnimationEditorIcons.Refresh}" />
                            </Button>
                            <Button Grid.Column="2" Classes="icon" Command="{CompiledBinding LoadResourceCommand}"
                                    CommandParameter="{CompiledBinding SelectedResource}"
                                    ToolTip.Tip="{x:Static loc:UiStrings.Load}"
                                    AutomationProperties.Name="{x:Static loc:UiStrings.Load}">
                                <PathIcon Data="{x:Static vm:AnimationEditorIcons.Load}" />
                            </Button>
                            <Button Grid.Column="3" Classes="icon" Command="{CompiledBinding UpdateResourceCommand}"
                                    ToolTip.Tip="{x:Static loc:UiStrings.Update}"
                                    AutomationProperties.Name="{x:Static loc:UiStrings.Update}">
                                <PathIcon Data="{x:Static vm:AnimationEditorIcons.Save}" />
                            </Button>
                            <Button Grid.Column="4" Classes="icon" Command="{CompiledBinding DeleteResourceCommand}"
                                    ToolTip.Tip="{x:Static loc:UiStrings.Delete}"
                                    AutomationProperties.Name="{x:Static loc:UiStrings.Delete}">
                                <PathIcon Data="{x:Static vm:AnimationEditorIcons.Delete}" />
                            </Button>
                        </Grid>

                        <TextBlock Classes="section" Text="{x:Static loc:UiStrings.Target}" />
                        <TextBlock Name="TargetName"
                                   Text="{CompiledBinding TargetDisplayName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Classes="section" Text="{x:Static loc:UiStrings.Keyframe}" />
                        <ContentControl Name="KeyframeEditor" Content="{CompiledBinding SelectedKeyframe}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:AnimationKeyframeViewModel">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                        <TextBlock Grid.Row="0" Classes="field-label" Text="{x:Static loc:UiStrings.Time}" />
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{CompiledBinding TimeSeconds, Mode=TwoWay}"
                                                 BorderBrush="{ReflectionBinding DataContext.IsKeyframeTimeValid, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static v:TimelineConverters.ValidityToBrush}}" />
                                        <TextBlock Grid.Row="1" Classes="field-label" Text="{x:Static loc:UiStrings.Value}" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{CompiledBinding Value, Mode=TwoWay}"
                                                 BorderBrush="{ReflectionBinding DataContext.IsKeyframeValueValid, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static v:TimelineConverters.ValidityToBrush}}" />
                                        <TextBlock Grid.Row="2" Classes="field-label" Text="{x:Static loc:UiStrings.Easing}" />
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{CompiledBinding Easing, Mode=TwoWay}"
                                                 BorderBrush="{ReflectionBinding DataContext.IsKeyframeEasingValid, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static v:TimelineConverters.ValidityToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <TextBlock Name="KeyframeValidation"
                                   Text="{CompiledBinding KeyframeValidationMessage}"
                                   IsVisible="{CompiledBinding KeyframeValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="#E24A4A"
                                   TextWrapping="Wrap"
                                   Opacity="0.9" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
