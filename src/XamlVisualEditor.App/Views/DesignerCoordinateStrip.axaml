<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="using:XamlVisualEditor.Designer.Core"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
             x:Class="XamlVisualEditor.App.Views.DesignerCoordinateStrip"
             x:DataType="dc:DesignSurfaceViewModel"
             Classes="editor-chrome designer-toolbar"
             IsVisible="{CompiledBinding ShowCoordinateStrip}"
             AutomationProperties.Name="{x:Static loc:UiStrings.CoordinateStrip}">
    <UserControl.Styles>
        <Style Selector="Button.coordinate-value">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Styles>
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0" Padding="2,1">
        <DockPanel>
            <ToggleButton DockPanel.Dock="Left" IsChecked="{CompiledBinding IsMeasuring, Mode=TwoWay}"
                          Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="3"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          AutomationProperties.Name="{x:Static loc:UiStrings.Measure}" ToolTip.Tip="{x:Static loc:UiStrings.MeasureHint}">
                <PathIcon Width="14" Height="14" Data="{x:Static dc:DesignerViewportIcons.MeasureIconPath}" />
            </ToggleButton>
            <TextBlock DockPanel.Dock="Right" Text="{CompiledBinding Zoom, StringFormat='{}{0:P0}'}"
                       VerticalAlignment="Center" Margin="6,0" FontSize="11"
                       AutomationProperties.Name="{x:Static loc:UiStrings.Zoom}" />
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="coordinate-value" MinWidth="104" HorizontalContentAlignment="Left"
                        Content="{CompiledBinding Readout.PointerText, TargetNullValue='–'}"
                        Command="{CompiledBinding CopyReadoutCommand}" CommandParameter="{CompiledBinding Readout.PointerValue}"
                        AutomationProperties.Name="{x:Static loc:UiStrings.PointerPosition}"
                        ToolTip.Tip="{x:Static loc:UiStrings.PointerPositionHint}" />
                <Button Classes="coordinate-value" MaxWidth="260"
                        IsVisible="{CompiledBinding Readout.HoverText, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Command="{CompiledBinding CopyReadoutCommand}" CommandParameter="{CompiledBinding Readout.HoverText}"
                        AutomationProperties.Name="{x:Static loc:UiStrings.ElementUnderPointer}"
                        ToolTip.Tip="{x:Static loc:UiStrings.ElementUnderPointerHint}">
                    <TextBlock Text="{CompiledBinding Readout.HoverText}" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button Classes="coordinate-value"
                        IsVisible="{CompiledBinding Readout.SelectionText, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Content="{CompiledBinding Readout.SelectionText}"
                        Command="{CompiledBinding CopyReadoutCommand}" CommandParameter="{CompiledBinding Readout.SelectionValue}"
                        AutomationProperties.Name="{x:Static loc:UiStrings.SelectionBounds}"
                        ToolTip.Tip="{x:Static loc:UiStrings.SelectionBoundsHint}" />
                <TextBlock IsVisible="{CompiledBinding Readout.ChangeText, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{CompiledBinding Readout.ChangeText}" VerticalAlignment="Center" Margin="6,0"
                           FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="11"
                           Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                           AutomationProperties.Name="{x:Static loc:UiStrings.SelectionChange}" />
                <Button Classes="coordinate-value"
                        IsVisible="{CompiledBinding Readout.MeasureText, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Content="{CompiledBinding Readout.MeasureText}"
                        Command="{CompiledBinding CopyReadoutCommand}" CommandParameter="{CompiledBinding Readout.MeasureValue}"
                        AutomationProperties.Name="{x:Static loc:UiStrings.MeasureResult}"
                        ToolTip.Tip="{x:Static loc:UiStrings.MeasureResultHint}" />
            </WrapPanel>
        </DockPanel>
    </Border>
</UserControl>
