<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
             x:Class="XamlVisualEditor.App.Views.LspSettingsView"
             x:DataType="vm:LspSettingsViewModel">
  <DockPanel Margin="8">
    <StackPanel Spacing="8">
      <TextBlock Text="{x:Static loc:UiStrings.LspSettings}" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{x:Static loc:UiStrings.SettingsFileLabel}" FontSize="12" />
      <TextBlock Text="{CompiledBinding SettingsPath}" FontSize="12" />

      <TextBlock Text="{x:Static loc:UiStrings.EnvironmentOverridesSettingsHint}" FontSize="11" />

      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="{x:Static loc:UiStrings.AddServer}" Command="{CompiledBinding AddServerCommand}" />
        <Button Content="{x:Static loc:UiStrings.RemoveSelected}" Command="{CompiledBinding RemoveServerCommand}" />
        <Button Content="{x:Static loc:UiStrings.Reload}" Command="{CompiledBinding ReloadCommand}" />
        <Button Content="{x:Static loc:UiStrings.Save}" Command="{CompiledBinding SaveCommand}" />
        <TextBlock Text="{CompiledBinding StatusText}" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="{x:Static loc:UiStrings.LspRestartHint}"
                 IsVisible="{CompiledBinding RequiresRestart}"
                 FontSize="11" />

      <ListBox ItemsSource="{CompiledBinding Servers}" SelectedItem="{CompiledBinding SelectedServer}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LspServerEntryViewModel">
            <Border BorderThickness="1" BorderBrush="#3A3A3A" CornerRadius="4" Padding="8" Margin="0,0,0,6">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{x:Static loc:UiStrings.Language}" Width="90" />
                  <TextBox Text="{CompiledBinding LanguageId, Mode=TwoWay}" Width="180" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{x:Static loc:UiStrings.ServerPath}" Width="90" />
                  <TextBox Text="{CompiledBinding ServerPath, Mode=TwoWay}" Width="420" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{x:Static loc:UiStrings.ArgumentsLabel}" Width="90" />
                  <TextBox Text="{CompiledBinding Arguments, Mode=TwoWay}" Width="420" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{x:Static loc:UiStrings.WorkingDirectory}" Width="90" />
                  <TextBox Text="{CompiledBinding WorkingDirectory, Mode=TwoWay}" Width="420" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{x:Static loc:UiStrings.Extensions}" Width="90" />
                  <TextBox Text="{CompiledBinding FileExtensions, Mode=TwoWay}" Width="220" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </DockPanel>
</UserControl>
