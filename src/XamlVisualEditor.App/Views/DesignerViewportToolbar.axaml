<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="using:XamlVisualEditor.Designer.Core"
             xmlns:v="using:XamlVisualEditor.App.Views"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
             x:Class="XamlVisualEditor.App.Views.DesignerViewportToolbar"
             Classes="editor-chrome"
             x:DataType="dc:DesignSurfaceViewModel" x:Name="ToolbarRoot">
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="4,2">
        <WrapPanel Orientation="Horizontal">
            <WrapPanel.Styles>
                <Style Selector="WrapPanel > :is(Control)"><Setter Property="Margin" Value="2,1" /></Style>
            </WrapPanel.Styles>
            <TextBlock Text="{x:Static loc:UiStrings.ZoomLabel}" VerticalAlignment="Center" Margin="4,0" FontSize="12" />
            <Slider Minimum="{x:Static dc:DesignSurfaceViewModel.MinimumZoom}" Maximum="{x:Static dc:DesignSurfaceViewModel.MaximumZoom}"
                    TickFrequency="{x:Static dc:DesignSurfaceViewModel.ZoomStep}" SmallChange="{x:Static dc:DesignSurfaceViewModel.ZoomStep}"
                    LargeChange="{x:Static dc:DesignSurfaceViewModel.ZoomStep}" IsSnapToTickEnabled="True"
                    Value="{CompiledBinding Zoom, Mode=TwoWay}" Width="120" VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static loc:UiStrings.Zoom}" ToolTip.Tip="{x:Static loc:UiStrings.ZoomRangeHint}" />
            <TextBlock Text="{CompiledBinding Zoom, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" Margin="4,0" FontSize="12" />
            <Button Content="-" Command="{CompiledBinding ZoomOutCommand}" Padding="6,2" FontSize="12" />
            <Button Content="+" Command="{CompiledBinding ZoomInCommand}" Padding="6,2" FontSize="12" />
            <Button Content="100%" Command="{CompiledBinding ResetZoomCommand}" Padding="6,2" FontSize="12" />
            <Button Content="{x:Static loc:UiStrings.Fit}" Click="OnFitClick" Padding="6,2" FontSize="12" />
            <Button Content="{x:Static loc:UiStrings.ZoomSelectionShort}" Click="OnSelectionClick" Padding="6,2" FontSize="12" />
            <ComboBox x:Name="LibraryThemeSelector" ItemsSource="{CompiledBinding PreviewThemes}"
                      SelectedItem="{CompiledBinding SelectedPreviewTheme, Mode=TwoWay}"
                      IsVisible="{CompiledBinding HasPreviewThemeProviders}" IsEnabled="{CompiledBinding HasPreviewThemeCatalog}"
                      MinWidth="140" MaxWidth="240" VerticalAlignment="Center" Padding="6,2" FontSize="12"
                      AutomationProperties.Name="{x:Static loc:UiStrings.PreviewTheme}" ToolTip.Tip="{CompiledBinding PreviewThemeStatus}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="dc:DesignerThemeChoice">
                        <TextBlock Text="{CompiledBinding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{CompiledBinding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Separator />
            <Button Content="{x:Static loc:UiStrings.Settings}" Padding="6,2" FontSize="12">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Spacing="6" Margin="8" MinWidth="320">
                            <StackPanel.Styles>
                                <Style Selector="WrapPanel > ToggleButton">
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                </Style>
                            </StackPanel.Styles>
                            <ToggleButton IsChecked="{CompiledBinding ShowGrid, Mode=TwoWay}" Content="{x:Static loc:UiStrings.ViewportGrid}" />
                            <ToggleButton IsChecked="{CompiledBinding SnapToGrid, Mode=TwoWay}" Content="{x:Static loc:UiStrings.SnapGrid}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Static loc:UiStrings.Variant}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{CompiledBinding ThemeVariants}" SelectedItem="{CompiledBinding PreviewThemeVariant, Mode=TwoWay}" MinWidth="140" />
                            </StackPanel>
                            <Separator />
                            <WrapPanel Orientation="Horizontal">
                                <ToggleButton IsChecked="{CompiledBinding ShowAlignmentGuides, Mode=TwoWay}" Content="{x:Static loc:UiStrings.Align}" />
                                <ToggleButton IsChecked="{CompiledBinding SnapLinesEnabled, Mode=TwoWay}" Content="{x:Static loc:UiStrings.SnapAlign}" />
                                <ToggleButton IsChecked="{CompiledBinding ShowSpacingGuides, Mode=TwoWay}" Content="{x:Static loc:UiStrings.Spacing}" />
                            </WrapPanel>
                            <Separator />
                            <WrapPanel Orientation="Horizontal">
                                <ToggleButton IsChecked="{CompiledBinding ShowGuides, Mode=TwoWay}" Content="{x:Static loc:UiStrings.Guides}" />
                                <ToggleButton IsChecked="{CompiledBinding SnapToGuides, Mode=TwoWay}" Content="{x:Static loc:UiStrings.SnapGuides}"
                                              ToolTip.Tip="{x:Static loc:UiStrings.SnapGuidesHint}" />
                                <ToggleButton IsChecked="{CompiledBinding ShowRulers, Mode=TwoWay}" Content="{x:Static loc:UiStrings.Rulers}" />
                            </WrapPanel>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="{x:Static loc:UiStrings.CanvasGap}" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{CompiledBinding CanvasGap, Mode=TwoWay}"
                                               Minimum="0" Maximum="64" Increment="1" FormatString="0" MinWidth="140"
                                               HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static loc:UiStrings.CanvasGapPixels}"
                                               ToolTip.Tip="{x:Static loc:UiStrings.CanvasGapHint}" />
                            </Grid>
                            <Separator />
                            <ToggleButton IsChecked="{CompiledBinding ShowMarginPadding, Mode=TwoWay}" Content="{x:Static loc:UiStrings.MarginPadding}"
                                          ToolTip.Tip="{x:Static loc:UiStrings.MarginPaddingHint}" />
                            <ToggleButton IsChecked="{CompiledBinding IsEditMode, Mode=TwoWay}" Content="{x:Static loc:UiStrings.Edit}" />
                            <Separator />
                            <ToggleButton IsChecked="{CompiledBinding AutoGenerateAutomationIds, Mode=TwoWay}" Content="{x:Static loc:UiStrings.AutomationIds}"
                                          ToolTip.Tip="{x:Static loc:UiStrings.AutomationIdsHint}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <v:DesignerLayoutToolbar VerticalAlignment="Center" />
        </WrapPanel>
    </Border>
</UserControl>
