<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:dh="using:Avalonia.Controls.DataGridHierarchical"
             xmlns:media="using:Avalonia.Media"
             xmlns:vm="using:XamlVisualEditor.TfvcExtension.ViewModels"
             xmlns:views="using:XamlVisualEditor.TfvcExtension.Views"
             xmlns:loc="using:XamlVisualEditor.TfvcExtension.Localization"
             x:Class="XamlVisualEditor.TfvcExtension.Views.SourceControlExplorerView"
             x:DataType="vm:SourceControlExplorerViewModel"
             views:ClipboardInteractionBehavior.Interaction="{CompiledBinding CopyToClipboard}">

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:SourceControlItemViewModel" x:DataType="vm:SourceControlItemViewModel">
      <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{CompiledBinding ServerPath}">
        <ContentControl Content="{CompiledBinding Icon}" VerticalAlignment="Center">
          <ContentControl.DataTemplates>
            <DataTemplate x:DataType="media:IImage">
              <Image Width="16" Height="16" Source="{CompiledBinding .}" />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        <TextBlock Text="{CompiledBinding Name}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel Margin="6">
    <!-- Activity of this panel at its top edge; the strip keeps its height, so the layout never moves. -->
    <Border DockPanel.Dock="Top" Height="2" Margin="-6,-6,-6,4" IsHitTestVisible="False">
      <ProgressBar Height="2" MinHeight="2" IsIndeterminate="True">
        <ProgressBar.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.Or}">
            <Binding Path="IsWorking" />
            <Binding Path="Connection.IsBusy" />
          </MultiBinding>
        </ProgressBar.IsVisible>
      </ProgressBar>
    </Border>

    <views:TfvcConnectionView DockPanel.Dock="Top" DataContext="{CompiledBinding Connection}" Margin="0,0,0,6" />

    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
      <Button Content="{x:Static loc:TfvcStrings.Refresh}" Command="{CompiledBinding RefreshCommand}" Padding="8,2" Margin="0,0,4,4" />
      <Button Content="{x:Static loc:TfvcStrings.LocateActiveDocument}" Command="{CompiledBinding LocateActiveDocumentCommand}" Padding="8,2" Margin="0,0,4,4" />
      <Button Content="{x:Static loc:TfvcStrings.GetLatest}" Command="{CompiledBinding GetLatestCommand}" Padding="8,2" Margin="0,0,4,4" />
    </WrapPanel>

    <TextBox DockPanel.Dock="Top" Margin="0,0,0,6"
             Text="{CompiledBinding SearchText, Mode=TwoWay}"
             PlaceholderText="{x:Static loc:TfvcStrings.Search}"
             AutomationProperties.Name="{x:Static loc:TfvcStrings.Search}" />

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
      <TextBlock Grid.Column="0" Text="{x:Static loc:TfvcStrings.SourceLocation}" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBox Grid.Column="1"
               Text="{CompiledBinding PathText, Mode=TwoWay}"
               AutomationProperties.Name="{x:Static loc:TfvcStrings.SourceLocation}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{CompiledBinding NavigateCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="2" Margin="4,0,0,0" Padding="8,2"
              Content="{x:Static loc:TfvcStrings.Go}"
              Command="{CompiledBinding NavigateCommand}" />
    </Grid>

    <TextBlock DockPanel.Dock="Top"
               Text="{CompiledBinding OperationMessage}"
               TextWrapping="Wrap"
               Margin="0,0,0,6"
               IsVisible="{CompiledBinding OperationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6"
          IsVisible="{CompiledBinding FocusedPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Grid.Column="0" Text="{x:Static loc:TfvcStrings.FocusedOn}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBlock Grid.Column="1" Text="{CompiledBinding FocusedPath}" TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{CompiledBinding FocusedPath}" VerticalAlignment="Center" />
      <Button Grid.Column="2" Margin="4,0,0,0" Padding="8,2"
              Content="{x:Static loc:TfvcStrings.ClearFocus}"
              Command="{CompiledBinding ClearFocusCommand}" />
    </Grid>

    <dg:DataGrid Classes="explorer-compact"
                 ItemsSource="{CompiledBinding Model.Flattened}"
                 HierarchicalModel="{CompiledBinding Model}"
                 HierarchicalRowsEnabled="True"
                 SelectedItem="{CompiledBinding SelectedRow, Mode=TwoWay}"
                 SortingModel="{CompiledBinding SortingModel}"
                 FilteringModel="{CompiledBinding FilteringModel}"
                 SearchModel="{CompiledBinding SearchModel}"
                 HeadersVisibility="Column"
                 GridLinesVisibility="None"
                 CanUserResizeColumns="True"
                 CanUserSortColumns="True"
                 IsReadOnly="True"
                 HorizontalScrollBarVisibility="Auto"
                 views:ScrollSelectionIntoViewBehavior.IsEnabled="True"
                 views:RightClickSelectBehavior.IsEnabled="True"
                 views:DoubleTapCommandBehavior.Command="{CompiledBinding OpenCommand}">
      <dg:DataGrid.ContextMenu>
        <ContextMenu x:DataType="vm:SourceControlExplorerViewModel">
          <MenuItem Header="{x:Static loc:TfvcStrings.Open}" Command="{CompiledBinding OpenCommand}" />
          <MenuItem Header="{x:Static loc:TfvcStrings.ShowHistory}" Command="{CompiledBinding ShowHistoryCommand}" />
          <MenuItem Header="{x:Static loc:TfvcStrings.CopyName}" Command="{CompiledBinding CopyNameCommand}" />
          <MenuItem Header="{x:Static loc:TfvcStrings.CopyPath}" Command="{CompiledBinding CopyPathCommand}" />
          <Separator />
          <MenuItem Header="{x:Static loc:TfvcStrings.FocusFolder}" Command="{CompiledBinding FocusSelectedCommand}" />
          <MenuItem Header="{x:Static loc:TfvcStrings.ClearFocus}" Command="{CompiledBinding ClearFocusCommand}" />
          <Separator />
          <MenuItem Header="{x:Static loc:TfvcStrings.GetLatest}" Command="{CompiledBinding GetLatestCommand}" />
          <MenuItem Header="{x:Static loc:TfvcStrings.CheckOut}" Command="{CompiledBinding CheckOutCommand}" />
          <Separator />
          <MenuItem Header="{x:Static loc:TfvcStrings.Undo}" Command="{CompiledBinding UndoCommand}" />
          <Separator />
          <MenuItem Header="{x:Static loc:TfvcStrings.Refresh}" Command="{CompiledBinding RefreshCommand}" />
        </ContextMenu>
      </dg:DataGrid.ContextMenu>
      <dg:DataGrid.Columns>
        <dg:DataGridHierarchicalColumn Header="{x:Static loc:TfvcStrings.ColumnName}"
                                       Width="280"
                                       MinWidth="120"
                                       Binding="{CompiledBinding Item}"
                                       SortMemberPath="Item.Name"
                                       x:DataType="dh:HierarchicalNode">
          <dg:DataGridHierarchicalColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}" VerticalContentAlignment="Center" />
            </DataTemplate>
          </dg:DataGridHierarchicalColumn.CellTemplate>
        </dg:DataGridHierarchicalColumn>
        <dg:DataGridTemplateColumn Header="{x:Static loc:TfvcStrings.ColumnPendingChange}" Width="120" SortMemberPath="Item.PendingChangeText">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}" VerticalContentAlignment="Center">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:SourceControlItemViewModel" x:DataType="vm:SourceControlItemViewModel">
                    <TextBlock Text="{CompiledBinding PendingChangeText}" VerticalAlignment="Center" />
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
        <dg:DataGridTemplateColumn Header="{x:Static loc:TfvcStrings.ColumnLocalSize}" Width="80" SortMemberPath="Item.LocalSizeBytes">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}" VerticalContentAlignment="Center" HorizontalContentAlignment="Right">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:SourceControlItemViewModel" x:DataType="vm:SourceControlItemViewModel">
                    <TextBlock Text="{CompiledBinding LocalSizeText}" ToolTip.Tip="{CompiledBinding LocalToolTip}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
        <dg:DataGridTemplateColumn Header="{x:Static loc:TfvcStrings.ColumnLocalModified}" Width="140" SortMemberPath="Item.LocalModified">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}" VerticalContentAlignment="Center">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:SourceControlItemViewModel" x:DataType="vm:SourceControlItemViewModel">
                    <TextBlock Text="{CompiledBinding LocalModifiedText}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{CompiledBinding LocalToolTip}" VerticalAlignment="Center" />
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
        <dg:DataGridTemplateColumn Header="{x:Static loc:TfvcStrings.ColumnLastCheckIn}" Width="130" SortMemberPath="Item.LastCheckIn">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}" VerticalContentAlignment="Center">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:SourceControlItemViewModel" x:DataType="vm:SourceControlItemViewModel">
                    <TextBlock Text="{CompiledBinding LastCheckInText}" VerticalAlignment="Center" />
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
        <dg:DataGridTemplateColumn Header="{x:Static loc:TfvcStrings.ColumnChangeset}" Width="80" SortMemberPath="Item.Version">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="dh:HierarchicalNode">
              <ContentControl Content="{CompiledBinding Item}" VerticalContentAlignment="Center">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="vm:SourceControlItemViewModel" x:DataType="vm:SourceControlItemViewModel">
                    <TextBlock Text="{CompiledBinding ChangesetText}" VerticalAlignment="Center" />
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
      </dg:DataGrid.Columns>
    </dg:DataGrid>
  </DockPanel>
</UserControl>
