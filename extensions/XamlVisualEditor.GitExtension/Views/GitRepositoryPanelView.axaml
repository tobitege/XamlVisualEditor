<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XamlVisualEditor.GitExtension"
             xmlns:gloc="using:XamlVisualEditor.GitExtension.Localization"
             x:Class="XamlVisualEditor.GitExtension.Views.GitRepositoryPanelView"
             x:DataType="vm:GitRepositoryPanelViewModel">

    <UserControl.Styles>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector=":is(Button).git-action">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
        <Style Selector=":is(Button).git-action PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector=":is(Button).git-action StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="4" />
        </Style>
        <Style Selector=":is(Button).git-action TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="MenuItem PathIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="6">
        <!-- Activity of this panel at its top edge; the strip keeps its height, so the layout never moves. -->
        <Border DockPanel.Dock="Top" Height="2" Margin="-6,-6,-6,4" IsHitTestVisible="False">
            <ProgressBar Height="2" MinHeight="2" IsIndeterminate="True" IsVisible="{CompiledBinding IsLoading}" />
        </Border>

        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
            <Button Classes="git-action" Command="{CompiledBinding RefreshCommand}"
                    ToolTip.Tip="{x:Static gloc:GitStrings.RefreshBranches}"
                    AutomationProperties.Name="{x:Static gloc:GitStrings.RefreshBranches}">
                <StackPanel>
                    <PathIcon Data="{x:Static vm:GitIcons.Refresh}" />
                    <TextBlock Text="{x:Static gloc:GitStrings.RefreshBranches}" />
                </StackPanel>
            </Button>
            <Button Classes="git-action" Command="{CompiledBinding FetchCommand}"
                    ToolTip.Tip="{x:Static gloc:GitStrings.FetchCommand}" ToolTip.ShowOnDisabled="True"
                    AutomationProperties.Name="{x:Static gloc:GitStrings.FetchCommand}">
                <StackPanel>
                    <PathIcon Data="{x:Static vm:GitIcons.Fetch}" />
                    <TextBlock Text="{x:Static gloc:GitStrings.FetchCommand}" />
                </StackPanel>
            </Button>
            <Button Classes="git-action" Command="{CompiledBinding PullCommand}"
                    ToolTip.Tip="{x:Static gloc:GitStrings.PullCommand}" ToolTip.ShowOnDisabled="True"
                    AutomationProperties.Name="{x:Static gloc:GitStrings.PullCommand}">
                <StackPanel>
                    <PathIcon Data="{x:Static vm:GitIcons.Pull}" />
                    <TextBlock Text="{x:Static gloc:GitStrings.PullCommand}" />
                </StackPanel>
            </Button>
            <Button Classes="git-action" Command="{CompiledBinding PushCommand}"
                    ToolTip.Tip="{x:Static gloc:GitStrings.PushCommand}" ToolTip.ShowOnDisabled="True"
                    AutomationProperties.Name="{x:Static gloc:GitStrings.PushCommand}">
                <StackPanel>
                    <PathIcon Data="{x:Static vm:GitIcons.Push}" />
                    <TextBlock Text="{x:Static gloc:GitStrings.PushCommand}" />
                </StackPanel>
            </Button>
            <Button Classes="git-action" Command="{CompiledBinding SyncCommand}"
                    ToolTip.Tip="{x:Static gloc:GitStrings.SyncCommand}" ToolTip.ShowOnDisabled="True"
                    AutomationProperties.Name="{x:Static gloc:GitStrings.SyncCommand}">
                <StackPanel>
                    <PathIcon Data="{x:Static vm:GitIcons.Sync}" />
                    <TextBlock Text="{x:Static gloc:GitStrings.SyncCommand}" />
                </StackPanel>
            </Button>
            <Button Classes="git-action" Command="{CompiledBinding CreateBranchCommand}"
                    ToolTip.Tip="{x:Static gloc:GitStrings.CreateBranchCommand}" ToolTip.ShowOnDisabled="True"
                    AutomationProperties.Name="{x:Static gloc:GitStrings.CreateBranchCommand}">
                <StackPanel>
                    <PathIcon Data="{x:Static vm:GitIcons.CreateBranch}" />
                    <TextBlock Text="{x:Static gloc:GitStrings.NewBranch}" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top"
                   Name="DetachedHead"
                   Text="{CompiledBinding DetachedHeadText}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"
                   IsVisible="{CompiledBinding DetachedHeadText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock DockPanel.Dock="Top"
                   Text="{CompiledBinding StatusMessage}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"
                   IsVisible="{CompiledBinding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TabControl>
            <TabItem Header="{x:Static gloc:GitStrings.BranchesTab}">
                <TreeView Name="BranchTree"
                          ItemsSource="{CompiledBinding Groups}"
                          SelectedItem="{CompiledBinding SelectedItem, Mode=TwoWay}"
                          IsEnabled="{CompiledBinding IsRepository}"
                          AutomationProperties.Name="{x:Static gloc:GitStrings.BranchesTab}">
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="vm:GitBranchGroupViewModel" x:DataType="vm:GitBranchGroupViewModel"
                                          ItemsSource="{CompiledBinding Branches}">
                            <TextBlock Text="{CompiledBinding Title}" FontWeight="SemiBold" />
                        </TreeDataTemplate>
                        <DataTemplate DataType="vm:GitBranchItemViewModel" x:DataType="vm:GitBranchItemViewModel">
                            <Grid ColumnDefinitions="18,*,Auto" Background="Transparent" ToolTip.Tip="{CompiledBinding ToolTip}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static gloc:GitStrings.SwitchToBranch}"
                                                  Command="{CompiledBinding SwitchCommand}"
                                                  CommandParameter="{CompiledBinding .}"
                                                  IsEnabled="{CompiledBinding CanSwitch}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{x:Static vm:GitIcons.CurrentBranch}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static gloc:GitStrings.NewBranchFromHere}"
                                                  Command="{CompiledBinding CreateBranchFromCommand}"
                                                  CommandParameter="{CompiledBinding .}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{x:Static vm:GitIcons.CreateBranch}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{x:Static gloc:GitStrings.DeleteBranchCommand}"
                                                  Command="{CompiledBinding DeleteCommand}"
                                                  CommandParameter="{CompiledBinding .}"
                                                  IsEnabled="{CompiledBinding CanDelete}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{x:Static vm:GitIcons.DeleteBranch}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <PathIcon Grid.Column="0" Width="12" Height="12"
                                          Data="{x:Static vm:GitIcons.CurrentBranch}"
                                          IsVisible="{CompiledBinding IsCurrent}"
                                          ToolTip.Tip="{x:Static gloc:GitStrings.CurrentBranch}" />
                                <TextBlock Grid.Column="1" Text="{CompiledBinding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{CompiledBinding TrackingText}" VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
