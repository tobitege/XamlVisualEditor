<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamlVisualEditor.FileExplorerExtension.ViewModels"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
        x:Class="XamlVisualEditor.FileExplorerExtension.Views.OpenFolderDialog"
        x:DataType="vm:OpenFolderDialogViewModel"
        Title="{x:Static loc:UiStrings.OpenFolder}"
        Classes="editor-chrome"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12" LastChildFill="True">
    <TextBlock DockPanel.Dock="Top"
               Text="{x:Static loc:UiStrings.OpenFolder}"
               FontSize="16"
               FontWeight="SemiBold"
               Margin="0,0,0,12" />

    <StackPanel Spacing="12">
      <StackPanel Spacing="6">
        <TextBlock Text="{x:Static loc:UiStrings.Folder}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="360"
                   Text="{CompiledBinding FolderPath, Mode=TwoWay}" />
          <Button Content="{x:Static loc:UiStrings.BrowseLabel}"
                  Command="{CompiledBinding BrowseCommand}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Content="{x:Static loc:UiStrings.Open}"
                Command="{CompiledBinding OpenCommand}"
                MinWidth="90" />
        <Button Content="{x:Static loc:UiStrings.Cancel}"
                Command="{CompiledBinding CancelCommand}"
                IsCancel="True"
                MinWidth="90" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
