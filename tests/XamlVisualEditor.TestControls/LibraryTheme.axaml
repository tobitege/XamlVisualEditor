<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XamlVisualEditor.TestControls"
        x:Class="XamlVisualEditor.TestControls.LibraryTheme">
  <Styles.Resources>
    <SolidColorBrush x:Key="LibraryInputBackground" Color="CornflowerBlue" />
    <ControlTheme x:Key="{x:Type local:LibraryInput}" TargetType="local:LibraryInput">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{DynamicResource LibraryInputBackground}" Padding="4">
            <TextBlock Text="{TemplateBinding Text}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>
</Styles>
