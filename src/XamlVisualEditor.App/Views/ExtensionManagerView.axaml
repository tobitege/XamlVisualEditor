<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
             x:Class="XamlVisualEditor.App.Views.ExtensionManagerView"
             x:DataType="vm:ExtensionManagerViewModel">
  <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="8,8,4,0">
      <WrapPanel.Styles>
        <Style Selector="Button">
          <Setter Property="Margin" Value="0,0,4,4" />
          <Setter Property="Padding" Value="8,3" />
        </Style>
      </WrapPanel.Styles>
      <Button Content="{x:Static loc:UiStrings.Refresh}"
              Command="{CompiledBinding RefreshCommand}" />
      <Button Content="{x:Static loc:UiStrings.InstallDialog}"
              Command="{CompiledBinding InstallCommand}" />
      <Button Content="{x:Static loc:UiStrings.CheckUpdates}"
              Command="{CompiledBinding CheckUpdatesCommand}" />
      <Button Content="{x:Static loc:UiStrings.Uninstall}"
              Command="{CompiledBinding UninstallCommand}"
              IsEnabled="{CompiledBinding HasSelection}" />
    </WrapPanel>
    <TextBlock DockPanel.Dock="Top"
               Text="{CompiledBinding StatusMessage}"
               TextWrapping="Wrap"
               Margin="8,0,8,4" />

    <dg:DataGrid ItemsSource="{CompiledBinding InstalledPackages}"
                SelectedItem="{CompiledBinding SelectedPackage, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                IsReadOnly="True"
                RowHeight="28"
                ColumnHeaderHeight="28"
                GridLinesVisibility="None">
      <dg:DataGrid.Columns>
        <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Name}"
                               Width="2*"
                               Binding="{CompiledBinding DisplayName}" />
        <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Version}"
                               Width="*"
                               Binding="{CompiledBinding Version}" />
        <dg:DataGridTemplateColumn Header="{x:Static loc:UiStrings.Enabled}"
                                   Width="Auto">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ExtensionPackageItemViewModel">
              <CheckBox IsChecked="{CompiledBinding IsEnabled, Mode=TwoWay}" />
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
        <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Update}"
                               Width="*"
                               Binding="{CompiledBinding UpdateLabel}" />
      </dg:DataGrid.Columns>
    </dg:DataGrid>
  </DockPanel>
</UserControl>
