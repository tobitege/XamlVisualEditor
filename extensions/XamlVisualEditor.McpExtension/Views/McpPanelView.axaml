<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="using:XamlVisualEditor.McpExtension"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
             x:Class="XamlVisualEditor.McpExtension.Views.McpPanelView"
             x:DataType="vm:McpPanelViewModel">
  <UserControl.Styles>
    <Style Selector="WrapPanel > Control">
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
  </UserControl.Styles>
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="#1B1E24" Padding="10" CornerRadius="8" Margin="8,8,8,6">
      <WrapPanel Orientation="Horizontal">
          <Border Background="#2A2F39" CornerRadius="10" Padding="8,2">
            <TextBlock Name="McpStatus" Text="{CompiledBinding StatusText}" TextWrapping="Wrap" MaxWidth="260" />
          </Border>
          <TextBlock Text="{x:Static loc:UiStrings.EndpointLabel}" Opacity="0.7" Margin="8,0,0,0" />
          <TextBlock Name="McpEndpoint" Text="{CompiledBinding EndpointText}" TextTrimming="CharacterEllipsis" MaxWidth="240"
                     ToolTip.Tip="{CompiledBinding EndpointText}" />
          <Button Content="{x:Static loc:UiStrings.CopyHttp}" Command="{CompiledBinding CopyHttpEndpointCommand}" Padding="6,2" />
          <Button Name="McpApply" Content="{x:Static loc:UiStrings.Apply}" Command="{CompiledBinding ApplySettingsCommand}" Padding="8,2" />
          <Button Content="{x:Static loc:UiStrings.Restart}" Command="{CompiledBinding RestartCommand}" Padding="8,2" />
      </WrapPanel>
    </Border>

    <Grid Margin="8" RowDefinitions="Auto,Auto,*" RowSpacing="12">
      <Border Grid.Row="0" Grid.Column="0" Background="#13161B" CornerRadius="8" Padding="10">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="8">
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static loc:UiStrings.Settings}" FontWeight="SemiBold" />
          <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="{x:Static loc:UiStrings.Enabled}" IsChecked="{CompiledBinding IsEnabled, Mode=TwoWay}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:UiStrings.Transport}" VerticalAlignment="Center" />
          <ComboBox Grid.Row="2" Grid.Column="1"
                    ItemsSource="{CompiledBinding TransportOptions}"
                    SelectedItem="{CompiledBinding SelectedTransport, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static loc:UiStrings.HttpPort}" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="65535" Value="{CompiledBinding HttpPort, Mode=TwoWay}" Width="120" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static loc:UiStrings.HttpPath}" VerticalAlignment="Center" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{CompiledBinding HttpPath, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="#13161B" CornerRadius="8" Padding="10">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowSpacing="8">
          <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{x:Static loc:UiStrings.Session}" FontWeight="SemiBold" />
          <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Static loc:UiStrings.Workspace}" VerticalAlignment="Center" />
          <TextBlock Name="McpWorkspace" Grid.Row="2" Grid.ColumnSpan="3" Text="{CompiledBinding WorkspaceId}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static loc:UiStrings.Token}" VerticalAlignment="Center" />
          <TextBox Name="McpToken" Grid.Row="3" Grid.Column="1" Text="{CompiledBinding SessionToken}" IsReadOnly="True" HorizontalAlignment="Stretch" />
          <Button Grid.Row="3" Grid.Column="2" Content="{x:Static loc:UiStrings.Copy}" Command="{CompiledBinding CopyTokenCommand}" Padding="6,2" />
          <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static loc:UiStrings.Clients}" VerticalAlignment="Center" />
          <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <TextBlock Text="{CompiledBinding ConnectionCount}" />
            <TextBlock Text="{x:Static loc:UiStrings.Last}" Opacity="0.6" Margin="12,0,0,0" />
            <TextBlock Text="{CompiledBinding LastConnectionAt}" TextWrapping="Wrap" />
          </WrapPanel>
        </Grid>
      </Border>

      <TabControl Grid.Row="2">
        <TabItem Header="{x:Static loc:UiStrings.Allowlist}">
          <Border Background="#13161B" CornerRadius="8" Padding="10">
            <DockPanel LastChildFill="True">
              <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <TextBlock Text="{x:Static loc:UiStrings.Allowlist}" FontWeight="SemiBold" />
                <Button Content="{x:Static loc:UiStrings.Refresh}" Command="{CompiledBinding RefreshPermissionsCommand}" Padding="6,2" />
                <Button Content="{x:Static loc:UiStrings.Revoke}" Command="{CompiledBinding RevokePermissionCommand}" Padding="6,2" />
                <Button Content="{x:Static loc:UiStrings.ClearAll}" Command="{CompiledBinding ClearPermissionsCommand}" Padding="6,2" />
              </WrapPanel>
              <dg:DataGrid ItemsSource="{CompiledBinding Permissions}"
                           SelectedItem="{CompiledBinding SelectedPermission, Mode=TwoWay}"
                           AutoGenerateColumns="False"
                           CanUserResizeColumns="True"
                           GridLinesVisibility="None"
                           IsReadOnly="True"
                           Margin="0,8,0,0">
                <dg:DataGrid.Columns>
                  <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Workspace}" Width="2*" x:DataType="vm:McpPermissionEntryViewModel" Binding="{CompiledBinding WorkspaceId}" />
                  <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Access}" Width="*" x:DataType="vm:McpPermissionEntryViewModel" Binding="{CompiledBinding AccessLevel}" />
                  <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Granted}" Width="*" x:DataType="vm:McpPermissionEntryViewModel" Binding="{CompiledBinding GrantedAt}" />
                  <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Token}" Width="2*" x:DataType="vm:McpPermissionEntryViewModel" Binding="{CompiledBinding SessionToken}" />
                </dg:DataGrid.Columns>
              </dg:DataGrid>
            </DockPanel>
          </Border>
        </TabItem>
        <TabItem Header="{x:Static loc:UiStrings.Activity}">
          <Border Background="#13161B" CornerRadius="8" Padding="10">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:UiStrings.Activity}" FontWeight="SemiBold" />
              <dg:DataGrid ItemsSource="{CompiledBinding ActivityLog}"
                           AutoGenerateColumns="False"
                           CanUserResizeColumns="True"
                           GridLinesVisibility="None"
                           IsReadOnly="True"
                           Margin="0,8,0,0">
                <dg:DataGrid.Columns>
                  <dg:DataGridTextColumn Header="{x:Static loc:UiStrings.Event}" Width="*" x:DataType="sys:String" Binding="{CompiledBinding}" />
                </dg:DataGrid.Columns>
              </dg:DataGrid>
            </DockPanel>
          </Border>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
