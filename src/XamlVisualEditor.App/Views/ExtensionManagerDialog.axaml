<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:XamlVisualEditor.App.Views"
        xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             xmlns:loc="clr-namespace:XamlVisualEditor.Core.Localization;assembly=XamlVisualEditor.Core"
        x:Class="XamlVisualEditor.App.Views.ExtensionManagerDialog"
        Classes="editor-chrome"
        x:DataType="vm:ExtensionManagerViewModel"
        Title="{x:Static loc:UiStrings.Extensions}"
        Width="880" Height="600"
        MinWidth="640" MinHeight="360"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{CompiledBinding CloseCommand}" />
  </Window.KeyBindings>
  <DockPanel Margin="8">
    <Button DockPanel.Dock="Bottom"
            Content="{x:Static loc:UiStrings.Close}"
            Command="{CompiledBinding CloseCommand}"
            HorizontalAlignment="Right"
            MinWidth="80"
            Margin="8" />
    <views:ExtensionManagerView />
  </DockPanel>
</Window>
